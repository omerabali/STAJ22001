datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CANDIDATE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(CANDIDATE)
  name         String?
  avatarUrl    String?
  resetCode    String?
  resetCodeExpires DateTime?
  createdAt    DateTime @default(now())
  cvs          CV[]
  searchLogs   SearchLog[]

  @@map("users")
}

model CV {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  rawText      String?
  hash         String?
  metadata     Json?
  structuredData Json?
  needsReview  Boolean      @default(false)
  extractionConfidence Float?
  extractionMethod String   @default("layout_aware")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  analyses     CVAnalysis[]
  chunks       CVChunk[]

  @@map("cvs")
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CVAnalysis {
  id                  String         @id @default(uuid())
  cvId                String
  cv                  CV             @relation(fields: [cvId], references: [id], onDelete: Cascade)
  status              AnalysisStatus @default(PENDING)
  atsScore            Int?
  skills              Json?
  strengths           Json?
  weaknesses          Json?
  suggestions         Json?
  interviewQuestions   Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("cv_analyses")
}

model CVChunk {
  id         String        @id @default(uuid())
  cvId       String
  cv         CV            @relation(fields: [cvId], references: [id], onDelete: Cascade)
  chunkText  String
  chunkIndex Int
  metadata   Json?
  createdAt  DateTime      @default(now())
  embeddings CVEmbedding[]

  @@map("cv_chunks")
}

model CVEmbedding {
  id        String   @id @default(uuid())
  chunkId   String
  chunk     CVChunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  model     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("cv_embeddings")
}

model APICall {
  id        String   @id @default(uuid())
  model     String
  tokensIn  Int
  tokensOut Int
  costUsd   Decimal  @db.Decimal(12, 10)
  endpoint  String
  status    String
  createdAt DateTime @default(now())

  @@map("api_calls")
}

model SearchLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@map("search_logs")
}

model CostLog {
  id              String   @id @default(uuid())
  cvId            String?
  analysisId      String?
  operation       String   // "CV_ANALYSIS", "EMBEDDING", "SEARCH" etc.
  durationMs      Int      // İşlem süresi (milisaniye)
  tokensUsed      Int?     // Kullanılan token sayısı
  estimatedCostUsd Decimal? @db.Decimal(12, 10)
  status          String   // "SUCCESS", "FAILED"
  metadata        Json?    // Ek detaylar (chunk sayısı, model, vs.)
  createdAt       DateTime @default(now())

  @@map("cost_logs")
}

model RankingAuditLog {
  id                String   @id @default(uuid())
  cvId              String
  searchQueryId     String?
  layer1_hardFilter Json?    // Hangi kriterler kod ile elendi
  layer2_gptScore   Int
  layer2_explanation String
  layer4_gptScore   Int      // İkinci bağımsız çağrı sonucu
  layer5_agreement  Boolean  // İki çağrı uyuştu mu
  finalScore        Int
  needsReview       Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@map("ranking_audit_logs")
}

model AnalysisAuditLog {
  id              String   @id @default(uuid())
  cvId            String
  pass1_atsScore  Int
  pass2_atsScore  Int
  scoreDelta      Int
  finalScore      Int
  usedThirdPass   Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@map("analysis_audit_logs")
}