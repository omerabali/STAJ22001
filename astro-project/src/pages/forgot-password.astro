---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Beacon - Şifremi Unuttum">
  <div style="position: absolute; inset: 0; display: flex; flex-direction: row; min-height: 100vh; width: 100%; background: #ffffff; font-family: 'Inter', sans-serif; color: #1c1b19; overflow-y: auto;">

    <!-- Left Side: Atmosphere (Same as Login & Register) -->
    <div style="position: relative; display: none; flex-direction: column; justify-content: center; width: 50%; background-color: #f7f3ef; padding: 64px; overflow: hidden; border-right: 1px solid #ded9d6; flex-shrink: 0; min-height: 100%; box-sizing: border-box;" class="left-panel">

      <!-- Dot grid background -->
      <div style="position: absolute; inset: 0; opacity: 0.03; pointer-events: none; background-image: radial-gradient(#1c1b19 1px, transparent 1px); background-size: 24px 24px;"></div>

      <!-- Floating Background Cards -->
      <div style="position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; opacity: 0.6;">
        <div class="animate-float" style="position: absolute; top: 128px; right: 48px; width: 256px; background: rgba(255,255,255,0.9); backdrop-filter: blur(12px); border: 1px solid rgba(222,217,214,0.6); border-radius: 12px; padding: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.04);">
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: rgba(230,226,222,0.8); flex-shrink: 0; display: flex; justify-content: center; align-items: center;">
              <span class="material-symbols-outlined" style="color: #2d5a45; font-size: 20px;">lock_reset</span>
            </div>
            <div style="flex: 1; display: flex; flex-direction: column; gap: 6px;">
              <div style="height: 8px; width: 80%; border-radius: 9999px; background: rgba(45,90,69,0.2);"></div>
              <div style="height: 8px; width: 50%; border-radius: 9999px; background: rgba(230,226,222,0.8);"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Brand Logo -->
      <div style="position: absolute; top: 48px; left: 64px; z-index: 10; display: flex; align-items: center; gap: 8px;">
        <img src="/mixboard-image.png" alt="Beacon Logo" style="height: 28px; width: auto; object-fit: contain;" />
        <span style="font-family: 'Manrope', sans-serif; font-size: 22px; font-weight: 700; color: #1c1b19;">Beacon</span>
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #2d5a45; margin-left: 2px;"></span>
      </div>

      <!-- Main Content -->
      <div style="position: relative; z-index: 10; max-width: 480px;">
        <h2 style="font-family: 'Manrope', sans-serif; font-size: 44px; line-height: 52px; letter-spacing: -0.02em; font-weight: 700; color: #1c1b19; margin-bottom: 20px; margin-top: 20px;">
          Şifrenizi güvenle sıfırlayın.
        </h2>
        <p style="font-size: 16px; line-height: 26px; color: #414943; margin-bottom: 36px;">
          Kayıtlı e-posta adresinizi veya telefon numaranızı girin, size tek kullanımlık doğrulama kodu gönderelim.
        </p>
        <ul style="display: flex; flex-direction: column; gap: 12px; list-style: none; padding: 0; margin: 0;">
          <li style="display: flex; align-items: center; gap: 12px;">
            <span class="material-symbols-outlined" style="color: #2d5a45; font-size: 20px;">shield</span>
            <span style="font-size: 15px; color: #414943;">Güvenli 6 haneli doğrulama kodu</span>
          </li>
          <li style="display: flex; align-items: center; gap: 12px;">
            <span class="material-symbols-outlined" style="color: #2d5a45; font-size: 20px;">bolt</span>
            <span style="font-size: 15px; color: #414943;">Anında şifre yenileme ve giriş</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Right Side: Form Card -->
    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: #ffffff; padding: 32px; min-height: 100%; box-sizing: border-box;">
      <div style="width: 100%; max-width: 420px;">

        <!-- Form Header -->
        <div style="margin-bottom: 36px;">
          <div style="font-size: 12px; letter-spacing: 0.08em; font-weight: 500; color: #717973; text-transform: uppercase; margin-bottom: 4px; font-family: 'IBM Plex Sans', sans-serif;">BEACON</div>
          <h3 style="font-family: 'Manrope', sans-serif; font-size: 26px; line-height: 34px; font-weight: 700; color: #1c1b19; margin-bottom: 4px; margin-top: 0;" id="form-title">Şifremi Unuttum</h3>
          <p style="font-size: 15px; color: #414943; margin: 0;" id="form-desc">Kayıtlı e-posta adresinizi veya telefon numaranızı girin.</p>
        </div>

        <!-- Feedback Container -->
        <div id="error-feedback" style="display: none; width: 100%; background: #fff5f5; border: 1px solid #fecaca; color: #dc2626; font-size: 12px; font-weight: 600; padding: 12px; border-radius: 8px; margin-bottom: 20px; box-sizing: border-box;"></div>
        <div id="success-feedback" style="display: none; width: 100%; background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; font-size: 12px; font-weight: 600; padding: 12px; border-radius: 8px; margin-bottom: 20px; box-sizing: border-box;"></div>

        <!-- Form Box -->
        <div style="background: #ffffff; padding: 32px; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.06); border: 1px solid rgba(222,217,214,0.5);">
          <form id="forgot-password-form" autocomplete="off" style="display: flex; flex-direction: column; gap: 20px;">

            <!-- STEP 1: Email or Phone -->
            <div id="step-1" style="display: flex; flex-direction: column; gap: 20px;">
              <div>
                <label for="email_or_phone" style="display: block; font-size: 12px; letter-spacing: 0.08em; font-weight: 500; color: #414943; text-transform: uppercase; margin-bottom: 8px; font-family: 'IBM Plex Sans', sans-serif;">E-posta veya Telefon</label>
                <input
                  id="email_or_phone" name="email_or_phone" type="text" placeholder="ornek@email.com veya 5xxxxxxxxx" required autocomplete="off"
                  class="form-input"
                  style="width: 100%; height: 48px; padding: 0 16px; background: #faf9f5; border: 1px solid #ddd9d3; border-radius: 10px; font-size: 14px; color: #1c1b19; outline: none; transition: all 0.2s; box-sizing: border-box;"
                />
              </div>

              <button
                type="submit"
                id="submit-btn"
                style="width: 100%; height: 48px; background: #2d5a45; color: #ffffff; font-family: 'Manrope', sans-serif; font-size: 14px; font-weight: 700; border: none; border-radius: 10px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;"
              >
                <span>Doğrulama Kodu Gönder</span>
                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
              </button>
            </div>

            <!-- STEP 2: Verification Code & New Password (Hidden initially) -->
            <div id="step-2" style="display: none; flex-direction: column; gap: 16px;">
              <div>
                <label for="code" style="display: block; font-size: 12px; letter-spacing: 0.08em; font-weight: 500; color: #414943; text-transform: uppercase; margin-bottom: 8px; font-family: 'IBM Plex Sans', sans-serif;">6 Haneli Kod</label>
                <input
                  id="code" name="code" type="text" placeholder="123456" maxlength="6" autocomplete="one-time-code"
                  class="form-input"
                  style="width: 100%; height: 48px; padding: 0 16px; background: #faf9f5; border: 1px solid #ddd9d3; border-radius: 10px; font-size: 18px; font-weight: 700; letter-spacing: 0.2em; text-align: center; color: #14422f; outline: none; transition: all 0.2s; box-sizing: border-box;"
                />
              </div>

              <div>
                <label for="new_password" style="display: block; font-size: 12px; letter-spacing: 0.08em; font-weight: 500; color: #414943; text-transform: uppercase; margin-bottom: 8px; font-family: 'IBM Plex Sans', sans-serif;">Yeni Şifre</label>
                <input
                  id="new_password" name="new_password" type="password" placeholder="••••••••" autocomplete="new-password" value=""
                  class="form-input"
                  style="width: 100%; height: 48px; padding: 0 16px; background: #faf9f5; border: 1px solid #ddd9d3; border-radius: 10px; font-size: 14px; color: #1c1b19; outline: none; transition: all 0.2s; box-sizing: border-box;"
                />
              </div>

              <button
                type="button"
                id="verify-btn"
                style="width: 100%; height: 48px; background: #14422f; color: #ffffff; font-family: 'Manrope', sans-serif; font-size: 14px; font-weight: 700; border: none; border-radius: 10px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 8px;"
              >
                <span>Şifreyi Yenile ve Giriş Yap</span>
                <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span>
              </button>
            </div>

          </form>

          <div style="margin-top: 24px; text-align: center; border-top: 1px solid #ddd9d3; padding-top: 20px;">
            <a href="/login" style="font-size: 14px; color: #2d5a45; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
              <span>Giriş sayfasına dön</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

<script>
  import { initSendCodeStep } from '../scripts/forgotPassword/sendCodeStep';
  import { initVerifyCodeStep } from '../scripts/forgotPassword/verifyCodeStep';

  document.addEventListener('astro:page-load', () => {
    initSendCodeStep();
    initVerifyCodeStep();
  });

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initSendCodeStep();
    initVerifyCodeStep();
  }
</script>

<style>
  @media (min-width: 768px) {
    .left-panel {
      display: flex !important;
    }
  }

  .form-input {
    background-color: #faf9f5 !important;
    color: #1c1b19 !important;
  }

  .form-input:focus {
    border-color: #2d5a45 !important;
    box-shadow: 0 0 0 3px rgba(45, 90, 69, 0.12) !important;
    background-color: #ffffff !important;
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    -webkit-text-fill-color: #1c1b19 !important;
    -webkit-box-shadow: 0 0 0px 1000px #faf9f5 inset !important;
    transition: background-color 5000s ease-in-out 0s;
  }

  #submit-btn:hover {
    background: #1e4031 !important;
  }

  #verify-btn:hover {
    background: #0d2c1f !important;
  }
</style>
