---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Beacon - Şifremi Unuttum" theme="theme-login">
	<div class="theme-login bg-[#0d0d1a] text-on-surface antialiased min-h-screen flex flex-col md:flex-row font-body-md overflow-hidden">
		<!-- Left Side: Atmosphere (Same as Login) -->
        <div class="hidden md:flex flex-col w-1/2 relative p-margin-desktop overflow-hidden border-r border-white/5 justify-center min-h-screen">
        <!-- Background Glows -->
        <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-[20%] left-[10%] w-[400px] h-[400px] bg-[#7c5cfc]/20 rounded-full blur-[100px] animate-glow-1"></div>
        <div class="absolute bottom-[20%] right-[10%] w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[120px] animate-glow-2"></div>
        </div>
        
        <!-- Overlay Content -->
        <div class="relative z-10 flex flex-col">
        <div class="absolute top-0 left-0 -mt-24">
        <div class="font-headline-lg text-headline-lg font-bold tracking-tight text-on-surface flex items-center">
                            <img src="/mixboard-image.png" alt="Beacon Logo" class="h-8 w-auto object-contain" />
                            Beacon<span class="text-brand-accent ml-1">•</span>
        </div>
        </div>
        <div class="max-w-[480px]">
        <h1 class="font-display-lg text-display-lg text-on-surface mb-6 leading-tight">
                            Giriş yapmak için <br> SMS doğrulama kullanın.
                        </h1>
        <p class="font-body-lg text-xl text-on-surface/90 mb-8 leading-[1.8] max-w-[420px]">
                            Telefon numaranızı girin, size göndereceğimiz tek kullanımlık kod (OTP) ile hızlıca giriş yapın.
                        </p>
        </div>
        </div>
        </div>

        <!-- Right Side: Form -->
        <div class="w-full md:w-1/2 flex items-center justify-center p-6 sm:p-12 min-h-screen relative z-10">
        <div class="w-full max-w-md space-y-8">
        <div>
        <h2 class="font-headline-md text-headline-md text-white mb-2" id="form-title">Telefonla Giriş</h2>
        <p class="font-body-md text-on-surface-variant" id="form-desc">Kayıtlı telefon numaranızı girin.</p>
        </div>
        
        <div id="status-feedback" class="hidden w-full text-xs font-mono p-3 rounded-lg mb-4"></div>
        
        <form id="forgot-password-form" class="space-y-6">
        
        <!-- Step 1: Phone -->
        <div id="step-1">
            <label class="block text-sm font-medium text-on-surface mb-2" for="phone">Telefon Numarası</label>
            <input class="w-full bg-transparent border border-surface-variant rounded-lg px-4 py-3 text-white placeholder-on-surface-variant/50 input-glow focus:ring-0" id="phone" name="phone" placeholder="0555..." type="tel" required>
            
            <button class="w-full bg-[#7c5cfc] text-white font-medium py-3 px-4 rounded-lg btn-glow mt-6" type="submit" id="submit-btn">
                Doğrulama Kodu Gönder
            </button>
        </div>

        <!-- Step 2: Code (Hidden initially) -->
        <div id="step-2" class="hidden">
            <label class="block text-sm font-medium text-on-surface mb-2" for="code">6 Haneli Doğrulama Kodu</label>
            <input class="w-full bg-transparent border border-surface-variant rounded-lg px-4 py-3 text-white placeholder-on-surface-variant/50 input-glow focus:ring-0 text-center tracking-widest text-xl" id="code" name="code" placeholder="------" type="text" maxlength="6">
            
            <button class="w-full bg-emerald-600 text-white font-medium py-3 px-4 rounded-lg btn-glow mt-6" type="button" id="verify-btn">
                Doğrula ve Giriş Yap
            </button>
        </div>

        </form>
        <div class="text-center mt-6">
        <p class="text-on-surface-variant"><a class="text-[#a78bfa] hover:text-white transition-colors font-medium" href="/login">Normal giriş sayfasına dön</a></p>
        </div>
        </div>
        </div>
	</div>
</Layout>

<script>
  import { initSendCodeStep } from '../scripts/forgotPassword/sendCodeStep';
  import { initVerifyCodeStep } from '../scripts/forgotPassword/verifyCodeStep';

  initSendCodeStep();
  initVerifyCodeStep();
</script>

<style>
	.btn-glow {
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.btn-glow:hover {
		transform: scale(1.02);
		box-shadow: 0 8px 25px rgba(124, 92, 252, 0.4);
	}
	.input-glow {
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}
	.input-glow:focus {
		border-color: #7c5cfc;
		box-shadow: 0 0 0 1px #7c5cfc, 0 0 15px rgba(124, 92, 252, 0.25);
		outline: none;
	}
	@keyframes glow-rotate {
		0% { transform: rotate(0deg) scale(1); }
		50% { transform: rotate(180deg) scale(1.1); }
		100% { transform: rotate(360deg) scale(1); }
	}
	.animate-glow-1 { animation: glow-rotate 25s linear infinite; }
	.animate-glow-2 { animation: glow-rotate 30s linear infinite reverse; }
</style>
