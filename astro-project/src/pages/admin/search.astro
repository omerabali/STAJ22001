---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Beacon - Aday Ara">
  <!-- Top Header -->
  <header class="mb-8">
    <h2 class="font-headline-md text-headline-md font-bold mb-2 text-[#1b1c1a]">Aday Ara</h2>
    <p class="font-body-md text-body-md text-[#8a8580]">Sistemdeki adayları vektörel anlamsal arama (AI) veya detaylı filtrelerle sorgulayın.</p>
  </header>

  <!-- Search Tabs -->
  <div class="flex border-b border-[#ddd9d3] mb-6 gap-6">
    <button id="tab-semantic" class="tab-btn active text-sm font-semibold pb-3 border-b-2 border-[#14422f] text-[#14422f] transition-all flex items-center gap-2">
      <span class="material-symbols-outlined text-[18px]">psychology</span>
      Yapay Zeka Semantik Arama
    </button>
    <button id="tab-basic" class="tab-btn text-sm font-semibold pb-3 border-b-2 border-transparent text-[#8a8580] hover:text-[#1b1c1a] transition-all flex items-center gap-2">
      <span class="material-symbols-outlined text-[18px]">manage_search</span>
      Genel Aday Listesi
    </button>
  </div>

  <!-- Search Sections Container -->
  <div>
    <!-- SECTION 1: AI SEMANTIC SEARCH -->
    <div id="section-semantic" class="tab-section">
      <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 mb-8 shadow-sm">
        <div class="relative flex items-center">
          <span class="material-symbols-outlined absolute left-4 text-[#8a8580]">psychology</span>
          <input 
            id="semantic-search-input"
            type="text" 
            placeholder="Python ve veri analizi bilen, en az 3 yıl deneyimli backend geliştirici..." 
            class="w-full bg-[#faf9f5] border border-[#ddd9d3] text-[#1b1c1a] rounded-[10px] pl-12 pr-[170px] py-4 focus:border-[#14422f] focus:ring-1 focus:ring-[#14422f] focus:outline-none font-body-md transition-all"
          />
          <div class="absolute right-2 flex items-center gap-2">
            <button 
              id="clear-semantic-search-btn" 
              class="text-[#8a8580] hover:text-red-500 hover:bg-red-50 p-2 rounded-lg transition-colors cursor-pointer flex items-center justify-center"
              title="Temizle"
            >
              <span class="material-symbols-outlined text-lg">close</span>
            </button>
            <button id="semantic-search-btn" class="bg-[#14422f] hover:bg-[#0f3223] text-white rounded-[8px] px-6 py-2.5 font-label-md flex items-center gap-2 transition-colors">
              <span class="material-symbols-outlined text-sm">bolt</span>
              AI Ara
            </button>
          </div>
        </div>

        <!-- Recent Searches Logs -->
        <div class="mt-4 flex flex-wrap items-center gap-2" id="search-history-container">
          <span class="text-xs text-[#8a8580] font-medium mr-2 flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">history</span> Son Aramalar:
          </span>
          <div id="search-logs-list" class="flex flex-wrap gap-2">
            <span class="text-xs text-[#8a8580] italic">Yükleniyor...</span>
          </div>
        </div>
      </div>

      <!-- Semantic Results Header -->
      <div class="flex justify-between items-center mb-6">
        <h3 class="font-headline-sm text-headline-sm font-bold text-[#1b1c1a]">AI Eşleşme Sonuçları</h3>
        <span id="semantic-result-count" class="text-[#8a8580] font-body-sm text-sm font-medium">Arama bekleniyor...</span>
      </div>

      <!-- Semantic Results Grid -->
      <div id="semantic-candidates-grid" class="grid grid-cols-1 gap-6">
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-12 flex flex-col items-center justify-center text-center shadow-sm">
          <span class="material-symbols-outlined text-5xl text-[#14422f]/20 mb-4">search</span>
          <p class="text-[#8a8580] font-body-md font-medium">Semantik AI aramasını başlatmak için yukarıya bir kriter yazıp "AI Ara" butonuna basın.</p>
        </div>
      </div>
    </div>

    <!-- SECTION 2: BASIC CANDIDATE DIRECTORY (Original view) -->
    <div id="section-basic" class="tab-section hidden">
      <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 mb-8 shadow-sm">
        <div class="relative flex items-center mb-6">
          <span class="material-symbols-outlined absolute left-4 text-[#8a8580]">search</span>
          <input 
            id="candidate-search-input"
            type="text" 
            placeholder="İsim veya e-posta ile ara..." 
            class="w-full bg-[#faf9f5] border border-[#ddd9d3] text-[#1b1c1a] rounded-[10px] pl-12 pr-[120px] py-4 focus:border-[#14422f] focus:ring-1 focus:ring-[#14422f] focus:outline-none font-body-md transition-all"
          />
          <button id="search-btn" class="absolute right-2 bg-[#14422f] hover:bg-[#0f3223] text-white rounded-[8px] px-6 py-2.5 font-label-md flex items-center gap-2 transition-colors">
            <span class="material-symbols-outlined text-sm">search</span>
            Ara
          </button>
        </div>

        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2" id="filter-pills">
          <button data-filter="all" class="filter-pill active bg-[#14422f] text-white px-4 py-1.5 rounded-full font-label-sm text-xs border border-[#14422f] transition-colors">Tümü</button>
          <button data-filter="completed" class="filter-pill bg-transparent border border-[#ddd9d3] text-[#8a8580] hover:text-[#1b1c1a] px-4 py-1.5 rounded-full font-label-sm text-xs transition-colors">Analiz Hazır</button>
          <button data-filter="processing" class="filter-pill bg-transparent border border-[#ddd9d3] text-[#8a8580] hover:text-[#1b1c1a] px-4 py-1.5 rounded-full font-label-sm text-xs transition-colors">İşleniyor</button>
          <button data-filter="pending" class="filter-pill bg-transparent border border-[#ddd9d3] text-[#8a8580] hover:text-[#1b1c1a] px-4 py-1.5 rounded-full font-label-sm text-xs transition-colors">Bekliyor / CV Yok</button>
        </div>
      </div>

      <!-- Results Header -->
      <div class="flex justify-between items-center mb-6">
        <h3 class="font-headline-sm text-headline-sm font-bold text-[#1b1c1a]">Genel Sonuçlar</h3>
        <span id="result-count-badge" class="text-[#8a8580] font-body-sm text-sm font-medium">Adaylar yükleniyor...</span>
      </div>

      <!-- Results Grid -->
      <div id="candidates-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 animate-pulse h-[200px] shadow-sm"></div>
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 animate-pulse h-[200px] shadow-sm"></div>
      </div>
    </div>
  </div>

  <!-- Floating Candidate Comparison Selection Bar -->
  <div id="compare-floating-bar" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-[#1b1c1a] text-white px-6 py-3 rounded-full shadow-2xl border border-white/10 hidden items-center gap-6 transition-all duration-300 transform translate-y-12">
    <div class="flex items-center gap-3">
      <span class="material-symbols-outlined text-[#14422f] bg-white rounded-full p-1 text-sm font-bold">compare_arrows</span>
      <span class="text-xs font-semibold" id="compare-bar-text">0 aday seçildi</span>
    </div>
    <div class="flex items-center gap-3">
      <button id="clear-compare-btn" class="text-xs text-[#8a8580] hover:text-white transition-colors underline cursor-pointer">Temizle</button>
      <button id="start-compare-btn" disabled class="bg-[#14422f] disabled:bg-gray-700 disabled:opacity-60 hover:bg-[#0f3223] text-white px-5 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer">
        <span>Karşılaştır</span>
        <span class="material-symbols-outlined text-xs">arrow_forward</span>
      </button>
    </div>
  </div>

  <style>
    .filter-pill.active {
      background-color: #14422f !important;
      color: white !important;
      border-color: #14422f !important;
    }
    .filter-pill:not(.active) {
      background-color: transparent;
      color: #8a8580;
    }
    .filter-pill:not(.active):hover {
      color: #1b1c1a;
      border-color: #8a8580;
    }
    .tab-btn.active {
      color: #14422f !important;
      border-color: #14422f !important;
    }
    .tab-section.hidden {
      display: none !important;
    }
    .pulse-bar {
      animation: pulse 1.5s infinite ease-in-out;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.6; }
      50% { opacity: 1; }
    }
  </style>

  <script>
    import { deleteSearchLog, fetchSearchLogs } from '../../scripts/admin/search/searchHistoryLogs';
    import { executeSemanticSearch, restoreCachedSemanticSearch } from '../../scripts/admin/search/semanticSearchEngine';
    import { renderCandidates } from '../../scripts/admin/search/directorySearch';
    import { toggleCompareCandidate } from '../../scripts/admin/search/candidateComparison';
    import { clearCompareCache } from '../../scripts/admin/compare/comparePageInit';

    const filterState = { currentFilter: 'all' };
    const isSearchLoadingState = { isSemanticLoading: false };
    let allUsersData: any[] = [];

    (window as any).deleteSearchLog = (logId: string, e: Event) => deleteSearchLog(logId, e);
    (window as any).toggleCompareCandidate = toggleCompareCandidate;
    (window as any).useSearchLogQuery = (queryText: string) => {
      const input = document.getElementById('semantic-search-input') as HTMLInputElement;
      if (input) {
        input.value = queryText;
      }
      executeSemanticSearch(isSearchLoadingState);
    };

    async function loadCandidatesData() {
      try {
        const res = await fetch('/api/admin/candidates');
        if (!res.ok) throw new Error();
        const data = await res.json();
        allUsersData = data.candidates || [];
        renderCandidates(allUsersData, filterState);
      } catch (err) {
        console.error("Aday listesi yüklenemedi:", err);
      }
    }

    function initSearchTabs() {
      const tabSemanticBtn = document.getElementById('tab-semantic');
      const tabBasicBtn = document.getElementById('tab-basic');
      const sectionSemantic = document.getElementById('section-semantic');
      const sectionBasic = document.getElementById('section-basic');

      function switchToBasic() {
        tabBasicBtn?.classList.add('border-[#14422f]', 'text-[#14422f]');
        tabBasicBtn?.classList.remove('border-transparent', 'text-[#8a8580]');
        tabSemanticBtn?.classList.remove('border-[#14422f]', 'text-[#14422f]');
        tabSemanticBtn?.classList.add('border-transparent', 'text-[#8a8580]');
        sectionBasic?.classList.remove('hidden');
        sectionSemantic?.classList.add('hidden');
        loadCandidatesData();
      }

      function switchToSemantic() {
        tabSemanticBtn?.classList.add('border-[#14422f]', 'text-[#14422f]');
        tabSemanticBtn?.classList.remove('border-transparent', 'text-[#8a8580]');
        tabBasicBtn?.classList.remove('border-[#14422f]', 'text-[#14422f]');
        tabBasicBtn?.classList.add('border-transparent', 'text-[#8a8580]');
        sectionSemantic?.classList.remove('hidden');
        sectionBasic?.classList.add('hidden');
        fetchSearchLogs();
        restoreCachedSemanticSearch();
      }

      tabSemanticBtn?.addEventListener('click', switchToSemantic);
      tabBasicBtn?.addEventListener('click', switchToBasic);

      // Check URL query param to activate tabs automatically
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('tab') === 'basic') {
        switchToBasic();
      } else if (urlParams.get('tab') === 'semantic') {
        switchToSemantic();
      } else {
        restoreCachedSemanticSearch();
      }
    }

    function initSearchPage() {
      clearCompareCache();
      initSearchTabs();
      fetchSearchLogs();
      loadCandidatesData();
      restoreCachedSemanticSearch();

      const searchBtn = document.getElementById('semantic-search-btn');
      searchBtn?.addEventListener('click', () => executeSemanticSearch(isSearchLoadingState));

      const input = document.getElementById('semantic-search-input');
      input?.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter') executeSemanticSearch(isSearchLoadingState);
      });

      const candInput = document.getElementById('candidate-search-input');
      candInput?.addEventListener('input', () => renderCandidates(allUsersData, filterState));

      const basicSearchBtn = document.getElementById('search-btn');
      basicSearchBtn?.addEventListener('click', () => renderCandidates(allUsersData, filterState));

      document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.addEventListener('click', (e: any) => {
          filterState.currentFilter = e.currentTarget.dataset.filter || 'all';
          document.querySelectorAll('.filter-pill').forEach(b => {
            b.classList.remove('active', 'bg-[#14422f]', 'text-white');
            b.classList.add('bg-transparent', 'text-[#8a8580]');
          });
          e.currentTarget.classList.add('active', 'bg-[#14422f]', 'text-white');
          e.currentTarget.classList.remove('bg-transparent', 'text-[#8a8580]');
          renderCandidates(allUsersData, filterState);
        });
      });
    }

    document.addEventListener('astro:page-load', initSearchPage);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initSearchPage();
    }
  </script>
</AdminLayout>
