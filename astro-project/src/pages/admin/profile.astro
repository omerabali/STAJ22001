        <div class="flex justify-between items-center pb-3 border-b border-[#ddd9d3]">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center font-bold">
              <span class="material-symbols-outlined text-[18px]">psychology</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-[#1b1c1a]">Yapay Zeka Analiz Ã–zeti</h3>
