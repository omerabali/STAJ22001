          <button id="copy-cv-text-btn" class="hidden items-center gap-1.5 text-xs font-semibold text-[#8a8580] hover:text-[#14422f] px-3 py-1.5 rounded-lg border border-[#ddd9d3] bg-white hover:bg-[#faf9f5] transition-colors shrink-0 cursor-pointer" title="TÃ¼m CV metnini kopyala">
            <span class="material-symbols-outlined text-[15px]">content_copy</span>
            <span id="copy-cv-text-label">Metni Kopyala</span>
          </button>
        </div>

        <!-- View Mode Tabs (Full Text vs Chunks) -->
        <div id="cv-view-tabs" class="hidden border-b border-[#ddd9d3] px-4 pt-3 bg-white flex gap-4 text-xs font-bold text-[#8a8580]">
          <button id="tab-fulltext" class="pb-2 border-b-2 border-[#14422f] text-[#14422f] cursor-pointer flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[15px]">article</span> Tam Metin
          </button>
          <button id="tab-chunks" class="pb-2 border-b-2 border-transparent hover:text-[#1b1c1a] cursor-pointer flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[15px]">segment</span> BÃ¶lÃ¼mler (Chunks)
          </button>
        </div>

        <!-- Placeholder -->
        <div class="flex flex-col items-center justify-center py-20 text-center px-6 gap-4" id="cv-viewer-placeholder">
