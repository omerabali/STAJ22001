          <div class="w-full bg-[#faf9f5] border border-[#ddd9d3] rounded-full h-2.5 overflow-hidden">
            <div id="swot-score-bar" class="h-full rounded-full bg-[#14422f] transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Strengths Section -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold text-emerald-800 uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600 text-[16px]">thumb_up</span>
            GÃ¼Ã§lÃ¼ YÃ¶nler (Strengths)
          </h4>
          <div id="swot-strengths-container" class="text-xs text-[#8a8580] italic">
            Bir CV seÃ§ildiÄŸinde veya analiz tamamlandÄ±ÄŸÄ±nda detaylar gÃ¶rÃ¼ntÃ¼lenecektir.
          </div>
        </div>

        <!-- Weaknesses Section -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold text-rose-800 uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-600 text-[16px]">build</span>
            Eksik YÃ¶nler (Gaps)
          </h4>
          <div id="swot-weaknesses-container" class="text-xs text-[#8a8580] italic">
            Eksik yÃ¶n verisi bekleniyor.
          </div>
        </div>

        <!-- Suggestions Section -->
        <div class="space-y-2">
          <h4 class="text-xs font-bold text-amber-800 uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-600 text-[16px]">lightbulb</span>
            MÃ¼lakat Ã–nerileri (Tavsiyeler)
