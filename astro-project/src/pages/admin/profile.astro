            </div>
            <div>
              <span class="text-[10px] font-bold text-[#8a8580] uppercase tracking-wider block">KAYIT TARÄ°HÄ°</span>
              <span class="font-semibold text-[#1b1c1a]" id="profile-date">-</span>
            </div>
          </div>
        </div>
      </div>

      <!-- AI Analiz Ã–zeti (SWOT TarzÄ± Ã‡Ä±ktÄ± Card) -->
