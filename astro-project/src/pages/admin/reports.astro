---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Raporlar | Beacon Admin">
  <div class="space-y-6 pb-12">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white border border-[#ddd9d3] rounded-[16px] p-6 shadow-xs">
      <div>
        <h1 class="text-xl font-extrabold text-[#1b1c1a] tracking-tight">Raporlar</h1>
        <p class="text-xs text-[#8a8580] font-medium mt-0.5">Platform analitik ve performans raporları.</p>
      </div>

      <div class="flex items-center gap-3">
        <!-- Timeframe Filter Buttons -->
        <div class="flex items-center bg-[#faf9f5] border border-[#ddd9d3] rounded-xl p-1 shadow-2xs">
          <button id="filter-week" class="px-3 py-1.5 rounded-md bg-white shadow-sm border border-[#ddd9d3] text-[#14422f] font-bold cursor-pointer text-xs transition-all">Bu Hafta</button>
          <button id="filter-month" class="px-3 py-1.5 rounded-md text-[#8a8580] hover:text-[#1b1c1a] transition-colors cursor-pointer text-xs font-semibold">Bu Ay</button>
          <button id="filter-all" class="px-3 py-1.5 rounded-md text-[#8a8580] hover:text-[#1b1c1a] transition-colors cursor-pointer text-xs font-semibold">Tüm Zamanlar</button>
        </div>

        <!-- Export Report Button (Excel) -->
        <button id="export-excel-btn" class="flex items-center gap-2 px-4 py-2 bg-[#14422f] hover:bg-[#103425] text-white rounded-xl text-xs font-bold transition-all shadow-xs hover:shadow-md active:scale-[0.98] cursor-pointer">
          <span class="material-symbols-outlined text-base">download</span>
          Rapor İndir
        </button>
      </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white border border-[#ddd9d3] rounded-[16px] p-5 shadow-xs hover:border-[#14422f]/30 transition-all">
        <span class="text-[11px] font-bold text-[#8a8580] uppercase tracking-wider block mb-1">TOPLAM CV</span>
        <span id="r-total-cvs" class="text-2xl font-extrabold text-[#1b1c1a]">-</span>
      </div>

      <div class="bg-white border border-[#ddd9d3] rounded-[16px] p-5 shadow-xs border-l-4 border-l-[#14422f] hover:border-[#14422f]/30 transition-all">
        <span class="text-[11px] font-bold text-[#8a8580] uppercase tracking-wider block mb-1">ANALİZ TAMAMLANAN</span>
        <span id="r-completed" class="text-2xl font-extrabold text-[#14422f]">-</span>
      </div>

      <div class="bg-white border border-[#ddd9d3] rounded-[16px] p-5 shadow-xs hover:border-[#14422f]/30 transition-all">
        <span class="text-[11px] font-bold text-[#8a8580] uppercase tracking-wider block mb-1">ORTALAMA UYUM SKORU</span>
        <span id="r-avg-score" class="text-2xl font-extrabold text-[#1b1c1a]">-</span>
      </div>

      <div class="bg-white border border-[#ddd9d3] rounded-[16px] p-5 shadow-xs hover:border-[#14422f]/30 transition-all">
        <span class="text-[11px] font-bold text-[#8a8580] uppercase tracking-wider block mb-1">BU HAFTA YÜKLENEN</span>
        <span id="r-weekly-uploads" class="text-2xl font-extrabold text-[#1b1c1a]">-</span>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Weekly CV Upload Bar Chart -->
      <div class="lg:col-span-2 bg-white border border-[#ddd9d3] rounded-[16px] p-6 shadow-xs flex flex-col justify-between">
        <div>
          <h3 class="text-sm font-extrabold text-[#1b1c1a] mb-1">Haftalık CV Yükleme</h3>
          <p class="text-xs text-[#8a8580] font-medium mb-6">Son 7 gün içerisinde sisteme yüklenen CV sayıları</p>
        </div>

        <div class="space-y-3">
          <div class="flex items-end gap-2 h-44 pt-4 border-b border-[#ddd9d3]" id="cv-bars-container">
            <!-- Dynamic Bars -->
          </div>
          <div class="flex justify-between px-1 text-xs text-[#8a8580] font-medium" id="cv-bars-labels">
            <!-- Dynamic Labels -->
          </div>
        </div>
      </div>

      <!-- Analysis Status Donut Chart -->
      <div class="bg-white border border-[#ddd9d3] rounded-[16px] p-6 shadow-xs flex flex-col justify-between">
        <div>
          <h3 class="text-sm font-extrabold text-[#1b1c1a] mb-1">Analiz Durum Dağılımı</h3>
          <p class="text-xs text-[#8a8580] font-medium mb-6">Sistemdeki tüm CV'lerin analiz oranları</p>
        </div>

        <div class="flex flex-col items-center justify-center my-auto py-2">
          <!-- SVG Donut Chart -->
          <div class="relative w-36 h-36">
            <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
              <!-- Background Circle -->
              <path class="text-[#f5f4f0]" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <!-- Completed Segment (Emerald) -->
              <path id="donut-completed" class="text-[#14422f] transition-all duration-1000" stroke-width="3.5" stroke-dasharray="0 100" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <!-- Processing Segment (Blue) -->
              <path id="donut-processing" class="text-blue-500 transition-all duration-1000" stroke-width="3.5" stroke-dasharray="0 100" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <!-- Pending Segment (Amber) -->
              <path id="donut-pending" class="text-amber-500 transition-all duration-1000" stroke-width="3.5" stroke-dasharray="0 100" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
              <span id="donut-center-total" class="text-xl font-extrabold text-[#1b1c1a]">-</span>
              <span class="text-[10px] font-bold text-[#8a8580] uppercase">TOPLAM</span>
            </div>
          </div>

          <!-- Donut Legend -->
          <div class="flex items-center gap-4 mt-6 text-xs font-semibold">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#14422f]"></span>
              <span class="text-[#1b1c1a]">Analiz Hazır (<span id="legend-completed">0%</span>)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
              <span class="text-[#8a8580]">İşleniyor (<span id="legend-processing">0%</span>)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="text-[#8a8580]">Bekliyor (<span id="legend-pending">0%</span>)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Table Section -->
    <div class="bg-white border border-[#ddd9d3] rounded-[16px] shadow-xs overflow-hidden">
      <div class="p-6 border-b border-[#ddd9d3]">
        <h3 class="text-sm font-extrabold text-[#1b1c1a]">Son Analizler</h3>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-[#faf9f5] border-b border-[#ddd9d3] text-[11px] font-bold text-[#8a8580] uppercase tracking-wider">
              <th class="py-3.5 px-6">ADAY</th>
              <th class="py-3.5 px-6">CV</th>
              <th class="py-3.5 px-6">TARİH</th>
              <th class="py-3.5 px-6">SKOR</th>
              <th class="py-3.5 px-6">DURUM</th>
            </tr>
          </thead>
          <tbody id="reports-table-body" class="divide-y divide-[#ddd9d3] text-xs text-[#1b1c1a]">
            <tr>
              <td colspan="5" class="p-8 text-center text-[#8a8580] font-medium">Analizler yükleniyor...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Table Footer / Expand Button -->
      <div id="reports-expand-container" class="hidden p-4 border-t border-[#ddd9d3] justify-center items-center bg-[#faf9f5]">
        <button id="reports-expand-btn" class="px-5 py-2 rounded-full border border-[#ddd9d3] bg-white text-xs font-bold text-[#1b1c1a] hover:bg-[#14422f] hover:text-white transition-all shadow-2xs flex items-center gap-1.5 cursor-pointer">
          <span id="reports-expand-text">Daha fazla göster</span>
          <span id="reports-expand-icon" class="material-symbols-outlined text-[16px]">expand_more</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    import { initExportCSV } from '../../scripts/admin/reports/exportCSV';
    import { loadRecentAnalyses } from '../../scripts/admin/reports/recentAnalysesLoader';
    import { loadReports } from '../../scripts/admin/reports/reportStatsLoader';

    function initReportsPage() {
      initExportCSV();
      loadReports('week');
      loadRecentAnalyses('week');
    }

    document.addEventListener('astro:page-load', initReportsPage);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initReportsPage();
    }
  </script>
</AdminLayout>
