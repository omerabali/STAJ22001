---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Beacon - CV Yükle">

  <!-- Page Header -->
  <section class="mb-8">
    <h2 class="font-headline-lg text-headline-lg text-[#1b1c1a] mb-1">CV Yükle ve Analiz Et</h2>
    <p class="font-body-lg text-body-lg text-[#8a8580] max-w-2xl font-medium">Platforma aday adına tekli veya toplu CV yükleyin.</p>
  </section>

  <div class="grid grid-cols-1 xl:grid-cols-[340px_1fr] gap-6 items-start">

    <!-- LEFT COLUMN: Candidate Selector + Upload -->
    <div class="flex flex-col gap-4">

      <!-- Candidate Selector Card -->
      <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-[#ddd9d3] flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-[8px] bg-[#14422f]/10 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[#14422f] text-[18px]">person_search</span>
          </div>
          <div>
            <p class="text-xs font-bold text-[#1b1c1a] leading-tight">Aday Seç</p>
            <p class="text-[10px] text-[#8a8580] font-medium">CV kime yüklensin?</p>
          </div>
        </div>

        <!-- Search box -->
        <div class="px-4 pt-3 pb-1">
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#8a8580] text-[16px] pointer-events-none">search</span>
            <input
              type="text"
              id="candidate-search"
              placeholder="İsim veya e-posta ara..."
              class="w-full bg-[#faf9f5] border border-[#ddd9d3] rounded-[8px] pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-[#14422f] font-medium text-[#1b1c1a] placeholder:text-[#8a8580]"
            />
          </div>
        </div>

        <!-- Candidate list -->
        <div class="px-4 pb-3 max-h-[220px] overflow-y-auto custom-scrollbar mt-2 space-y-1" id="candidate-list">
          <!-- "Admin (self)" option always first -->
          <button
            data-id=""
            data-name="Kendi hesabıma yükle (Admin)"
            class="candidate-item w-full flex items-center gap-3 px-3 py-2.5 rounded-[8px] text-left transition-colors bg-[#14422f]/8 border border-[#14422f]/20 selected"
          >
            <div class="w-7 h-7 rounded-full bg-[#14422f] flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-white text-[14px]">admin_panel_settings</span>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-[#14422f] truncate">Admin (Ben)</p>
              <p class="text-[10px] text-[#14422f]/70 font-medium truncate">Kendi hesabıma yükle</p>
            </div>
            <span class="material-symbols-outlined text-[#14422f] text-[16px] ml-auto shrink-0 check-icon">check_circle</span>
          </button>
          <!-- Dynamic candidates loaded here -->
          <div id="candidate-list-dynamic" class="space-y-1"></div>
          <div id="candidate-list-loading" class="py-4 text-center text-[10px] text-[#8a8580] font-medium">Adaylar yükleniyor...</div>
        </div>

        <!-- Selected badge -->
        <div class="px-4 pb-4 pt-0">
          <div class="bg-[#f5f4f0] border border-[#ddd9d3] rounded-[8px] px-3 py-2 flex items-center gap-2">
            <span class="material-symbols-outlined text-[#14422f] text-[16px]">how_to_reg</span>
            <span class="text-xs font-bold text-[#1b1c1a] truncate" id="selected-candidate-label">Admin (Ben)</span>
          </div>
          <!-- Hidden input for actual value -->
          <input type="hidden" id="admin-candidate-select" value="" />
        </div>
      </div>

      <!-- Upload Area Card -->
      <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm">
        <div
          id="drop-zone"
          class="m-4 border-2 border-dashed border-[#ddd9d3] rounded-[10px] p-8 flex flex-col items-center justify-center cursor-pointer hover:border-[#14422f]/40 hover:bg-[#14422f]/[0.02] transition-all duration-200"
        >
          <div class="w-12 h-12 rounded-full bg-[#14422f]/8 flex items-center justify-center mb-3 border border-[#14422f]/15">
            <span class="material-symbols-outlined text-[#14422f] text-2xl">upload_file</span>
          </div>
          <p class="text-sm font-bold text-[#1b1c1a] mb-1 text-center">Dosyaları buraya sürükle</p>
          <p class="text-[11px] text-[#8a8580] font-medium text-center mb-4">PDF · Çoklu seçim · Maks 5MB</p>
          <button class="bg-[#14422f] text-white text-xs font-bold px-5 py-2.5 rounded-[8px] hover:opacity-90 transition-opacity">
            Dosya Seç
          </button>
          <input type="file" id="cv-file-input" accept=".pdf" class="hidden" multiple />
        </div>

        <!-- Upload Queue -->
        <div class="hidden px-4 pb-4" id="upload-progress-container">
          <p class="text-[10px] font-bold text-[#8a8580] tracking-widest uppercase mb-2">Yükleme Kuyruğu</p>
          <div class="space-y-2" id="progress-items-list"></div>
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN: CV List + Chunk Viewer -->
    <div class="flex flex-col gap-6">

      <!-- CV List Table -->
      <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-[#ddd9d3] flex items-center justify-between">
          <h3 class="font-bold text-sm text-[#1b1c1a]">Yüklenen Özgeçmişler</h3>
          <span class="text-[10px] text-[#8a8580] font-medium" id="cv-count-label"></span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-[#f5f4f0] border-b border-[#ddd9d3] text-[10px] text-[#8a8580] uppercase font-bold tracking-wider">
                <th class="px-4 py-3">Dosya</th>
                <th class="px-4 py-3">Aday</th>
                <th class="px-4 py-3">Tarih</th>
                <th class="px-4 py-3">Durum</th>
                <th class="px-4 py-3 text-right">İşlem</th>
              </tr>
            </thead>
            <tbody class="text-sm text-[#1b1c1a] divide-y divide-[#ddd9d3]" id="my-cvs-body">
              <tr>
                <td colspan="5" class="p-8 text-center text-[#8a8580] font-medium text-sm">Yüklemeler sorgulanıyor...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Chunk Viewer -->
      <div class="hidden" id="chunk-viewer-section">
        <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-[#ddd9d3] flex items-center gap-3">
            <div class="w-8 h-8 rounded-[8px] bg-[#14422f]/10 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[#14422f] text-[18px]">segment</span>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-[#1b1c1a]" id="chunk-viewer-title">CV Parçaları</p>
              <p class="text-[10px] text-[#8a8580] font-medium" id="chunk-count-label"></p>
            </div>
          </div>
          <div class="p-4 space-y-3 max-h-[480px] overflow-y-auto custom-scrollbar" id="chunk-list">
            <!-- Dynamic chunks here -->
          </div>
        </div>
      </div>

    </div>
  </div>

<script is:inline>
{
  let activeCvId = null;
  let activeInterval = null;
  let allCandidates = [];

  // ─── Candidate Selection ───────────────────────────────────────────
  function renderCandidateList(filter) {
    const container = document.getElementById('candidate-list-dynamic');
    if (!container) return;

    const filtered = filter
      ? allCandidates.filter(c => {
          const name = (c.name || '').toLowerCase();
          const email = (c.email || '').toLowerCase();
          return name.includes(filter) || email.includes(filter);
        })
      : allCandidates;

    container.innerHTML = '';
    filtered.forEach(cand => {
      const label = cand.name ? `${cand.name}` : cand.email;
      const sub = cand.name ? cand.email : '';
      const initials = label.slice(0, 2).toUpperCase();
      const btn = document.createElement('button');
      btn.dataset.id = cand.id;
      btn.dataset.name = label;
      btn.className = 'candidate-item w-full flex items-center gap-3 px-3 py-2.5 rounded-[8px] text-left transition-colors hover:bg-[#f5f4f0] border border-transparent';
      btn.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-[#ddd9d3] flex items-center justify-center shrink-0 text-[10px] font-bold text-[#1b1c1a]">${initials}</div>
        <div class="min-w-0">
          <p class="text-xs font-bold text-[#1b1c1a] truncate">${label}</p>
          ${sub ? `<p class="text-[10px] text-[#8a8580] font-medium truncate">${sub}</p>` : ''}
        </div>
        <span class="material-symbols-outlined text-[#14422f] text-[16px] ml-auto shrink-0 check-icon hidden">check_circle</span>
      `;
      btn.addEventListener('click', () => selectCandidate(cand.id, label));
      container.appendChild(btn);
    });
  }

  async function loadCandidates() {
    const loading = document.getElementById('candidate-list-loading');
    try {
      const res = await fetch('/api/admin/candidates');
      if (!res.ok) throw new Error();
      const data = await res.json();
      allCandidates = data.candidates || [];
      if (loading) loading.style.display = 'none';
      renderCandidateList('');
    } catch {
      if (loading) loading.textContent = 'Adaylar yüklenemedi.';
    }
  }

  function selectCandidate(id, name) {
    // Update hidden input
    const input = document.getElementById('admin-candidate-select');
    if (input) input.value = id;

    // Update label
    const label = document.getElementById('selected-candidate-label');
    if (label) label.textContent = name || 'Admin (Ben)';

    // Highlight selection
    document.querySelectorAll('.candidate-item').forEach(btn => {
      const isSelected = btn.dataset.id === id;
      btn.classList.toggle('bg-[#14422f]/8', isSelected);
      btn.classList.toggle('border-[#14422f]/20', isSelected);
      btn.classList.toggle('selected', isSelected);
      const icon = btn.querySelector('.check-icon');
      if (icon) icon.classList.toggle('hidden', !isSelected);
    });
  }

  // Search filter
  document.getElementById('candidate-search')?.addEventListener('input', (e) => {
    renderCandidateList(e.target.value.toLowerCase().trim());
  });

  // Admin self option
  document.querySelector('.candidate-item[data-id=""]')?.addEventListener('click', () => {
    selectCandidate('', 'Admin (Ben)');
  });

  // ─── Delete CV ────────────────────────────────────────────────────
  window.deleteCV = async function(cvId) {
    if (!confirm('Bu CV ve tüm ilişkili verileri silmek istediğinize emin misiniz?')) return;
    try {
      const res = await fetch(`/api/cv/${cvId}`, { method: 'DELETE' });
      if (!res.ok) throw new Error((await res.json()).message || 'Silme başarısız.');
      if (activeCvId === cvId) {
        activeCvId = null;
        document.getElementById('chunk-viewer-section')?.classList.add('hidden');
      }
      await loadCVList();
    } catch (err) {
      alert(err.message);
    }
  };

  // ─── Chunk Viewer ─────────────────────────────────────────────────
  async function showChunks(cvId, fileName) {
    activeCvId = cvId;
    const section = document.getElementById('chunk-viewer-section');
    const title = document.getElementById('chunk-viewer-title');
    const countLabel = document.getElementById('chunk-count-label');
    const list = document.getElementById('chunk-list');
    if (!section || !list) return;

    title.textContent = fileName;
    countLabel.textContent = 'Yükleniyor...';
    list.innerHTML = `
      <div class="flex items-center justify-center py-10 gap-3 text-[#8a8580]">
        <span class="material-symbols-outlined animate-spin text-2xl">progress_activity</span>
        <span class="text-sm font-medium">Parçalar getiriliyor...</span>
      </div>
    `;
    section.classList.remove('hidden');

    try {
      const res = await fetch(`/api/cv/${cvId}/chunks`);
      if (!res.ok) throw new Error('Chunks alınamadı.');
      const data = await res.json();
      const chunks = data.chunks || [];

      countLabel.textContent = `${chunks.length} parça`;

      if (chunks.length === 0) {
        list.innerHTML = `
          <div class="py-10 text-center text-[#8a8580] text-sm font-medium">
            Bu CV için henüz parça oluşturulmamış. Analiz tamamlanınca tekrar deneyin.
          </div>
        `;
        return;
      }

      list.innerHTML = '';
      chunks.forEach((chunk, i) => {
        const div = document.createElement('div');
        div.className = 'border border-[#ddd9d3] rounded-[10px] overflow-hidden text-left bg-[#faf9f5]';
        div.innerHTML = `
          <div class="px-4 py-2.5 border-b border-[#ddd9d3] bg-white flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#14422f]/10 text-[10px] font-black text-[#14422f]">${i + 1}</span>
            <span class="text-[11px] font-bold text-[#8a8580] uppercase tracking-wider">Parça ${chunk.chunkIndex}</span>
          </div>
          <div class="px-4 py-3">
            <p class="text-xs text-[#1b1c1a] font-medium leading-relaxed whitespace-pre-wrap break-words">${escapeHtml(chunk.chunkText)}</p>
          </div>
        `;
        list.appendChild(div);
      });
    } catch {
      list.innerHTML = `<div class="py-8 text-center text-rose-600 text-sm font-medium">Parçalar yüklenirken hata oluştu.</div>`;
    }
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // ─── CV List ──────────────────────────────────────────────────────
  async function loadCVList() {
    const tbody = document.getElementById('my-cvs-body');
    const countLabel = document.getElementById('cv-count-label');
    if (!tbody) return;

    try {
      const res = await fetch('/api/cv/list');
      if (!res.ok) throw new Error();
      const data = await res.json();
      const cvs = data.cvs || [];

      if (countLabel) countLabel.textContent = `${cvs.length} kayıt`;

      if (cvs.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="p-10 text-center text-[#8a8580] font-medium text-sm">
              Henüz CV yüklenmedi.
            </td>
          </tr>
        `;
        clearInterval(activeInterval);
        activeInterval = null;
        return;
      }

      let hasPending = false;
      tbody.innerHTML = '';

      cvs.forEach(cv => {
        const analysis = cv.analyses?.[0];
        const status = analysis?.status ?? 'PENDING';
        if (status === 'PENDING' || status === 'PROCESSING') hasPending = true;

        const date = new Date(cv.createdAt).toLocaleDateString('tr-TR', {
          day: 'numeric', month: 'short', year: 'numeric'
        });

        const statusBadge = {
          PENDING: `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>Sırada</span>`,
          PROCESSING: `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200"><span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-ping"></span>İşleniyor</span>`,
          COMPLETED: `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Hazır</span>`,
          FAILED: `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Hata</span>`,
        }[status] ?? '';

        const userText = cv.user ? (cv.user.name || cv.user.email) : 'Admin';

        const tr = document.createElement('tr');
        tr.className = `hover:bg-[#f5f4f0]/60 transition-colors cursor-pointer group ${activeCvId === cv.id ? 'bg-[#f5f4f0]' : ''}`;
        tr.onclick = () => {
          activeCvId = cv.id;
          document.querySelectorAll('#my-cvs-body tr').forEach(r => r.classList.remove('bg-[#f5f4f0]'));
          tr.classList.add('bg-[#f5f4f0]');
          showChunks(cv.id, cv.fileName);
        };
        tr.innerHTML = `
          <td class="px-4 py-3">
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-red-500 text-[18px] shrink-0">picture_as_pdf</span>
              <span class="text-xs font-bold text-[#1b1c1a] truncate max-w-[200px]">${cv.fileName}</span>
            </div>
          </td>
          <td class="px-4 py-3 text-[11px] text-[#8a8580] font-semibold truncate max-w-[130px]">${userText}</td>
          <td class="px-4 py-3 text-[11px] text-[#8a8580] font-medium whitespace-nowrap">${date}</td>
          <td class="px-4 py-3">${statusBadge}</td>
          <td class="px-4 py-3 text-right" onclick="event.stopPropagation()">
            <button onclick="deleteCV('${cv.id}')" class="p-1.5 rounded-[6px] text-[#8a8580] hover:text-rose-600 hover:bg-rose-50 transition-colors" title="Sil">
              <span class="material-symbols-outlined text-[16px]">delete</span>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      if (hasPending && !activeInterval) {
        activeInterval = setInterval(loadCVList, 3000);
      } else if (!hasPending && activeInterval) {
        clearInterval(activeInterval);
        activeInterval = null;
      }
    } catch {
      tbody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-rose-600 text-sm font-medium">Liste yüklenirken hata oluştu.</td></tr>`;
    }
  }

  // ─── Upload with per-file progress ────────────────────────────────
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('cv-file-input');
  const progressContainer = document.getElementById('upload-progress-container');
  const progressList = document.getElementById('progress-items-list');

  dropZone?.addEventListener('click', () => fileInput?.click());
  dropZone?.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('border-[#14422f]', 'bg-[#14422f]/[0.03]'); });
  dropZone?.addEventListener('dragleave', () => { dropZone.classList.remove('border-[#14422f]', 'bg-[#14422f]/[0.03]'); });
  dropZone?.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('border-[#14422f]', 'bg-[#14422f]/[0.03]');
    if (e.dataTransfer?.files?.length) uploadFiles(e.dataTransfer.files);
  });
  fileInput?.addEventListener('change', () => { if (fileInput.files?.length) uploadFiles(fileInput.files); });

  function uploadFiles(files) {
    if (!progressContainer || !progressList) return;
    progressContainer.classList.remove('hidden');

    const selectedUserId = document.getElementById('admin-candidate-select')?.value || '';

    Array.from(files).forEach(file => {
      if (file.type !== 'application/pdf') {
        alert(`Geçersiz dosya: ${file.name}. Sadece PDF yüklenebilir.`);
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        alert(`Dosya boyutu fazla: ${file.name} (Maks 5MB)`);
        return;
      }

      const rowId = 'up-' + Math.random().toString(36).slice(2, 8);
      const item = document.createElement('div');
      item.id = rowId;
      item.className = 'bg-[#faf9f5] border border-[#ddd9d3] rounded-[8px] p-3 text-left';
      item.innerHTML = `
        <div class="flex items-center justify-between mb-2 gap-2">
          <div class="flex items-center gap-2 min-w-0">
            <span class="material-symbols-outlined text-red-500 text-[16px] shrink-0">picture_as_pdf</span>
            <span class="text-[11px] font-bold text-[#1b1c1a] truncate">${file.name}</span>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <span class="text-[11px] font-mono text-[#8a8580] progress-pct">0%</span>
            <button class="w-5 h-5 rounded-full flex items-center justify-center text-[#8a8580] hover:text-rose-600 hover:bg-rose-50 transition-colors remove-btn" title="Kaldır">
              <span class="material-symbols-outlined text-[14px]">close</span>
            </button>
          </div>
        </div>
        <div class="w-full bg-white border border-[#ddd9d3] h-1.5 rounded-full overflow-hidden">
          <div class="h-full w-0 bg-[#14422f] transition-all duration-150 progress-bar rounded-full"></div>
        </div>
        <p class="text-[10px] text-[#8a8580] font-medium mt-1.5 status-msg">Yükleniyor...</p>
      `;
      progressList.appendChild(item);

      const bar = item.querySelector('.progress-bar');
      const pct = item.querySelector('.progress-pct');
      const msg = item.querySelector('.status-msg');
      const removeBtn = item.querySelector('.remove-btn');

      let xhr = new XMLHttpRequest();

      removeBtn.addEventListener('click', () => {
        xhr.abort();
        item.remove();
        if (progressList.children.length === 0) progressContainer.classList.add('hidden');
      });

      const formData = new FormData();
      formData.append('cv', file);
      if (selectedUserId) formData.append('targetUserId', selectedUserId);

      xhr.upload.addEventListener('progress', e => {
        if (!e.lengthComputable) return;
        const p = Math.round((e.loaded / e.total) * 100);
        bar.style.width = p + '%';
        pct.textContent = p + '%';
        if (p === 100) msg.textContent = 'Sunucuya ulaştı, işleniyor...';
      });

      xhr.addEventListener('load', () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          bar.style.width = '100%';
          pct.textContent = '100%';
          msg.textContent = 'Yüklendi!';
          msg.className = 'text-[10px] font-bold text-emerald-600 mt-1.5 status-msg';
          removeBtn.classList.remove('hidden');
          loadCVList();
        } else {
          let errMsg = 'Yükleme başarısız.';
          try { errMsg = JSON.parse(xhr.responseText).message || errMsg; } catch {}
          msg.textContent = 'Hata: ' + errMsg;
          msg.className = 'text-[10px] font-bold text-rose-600 mt-1.5 status-msg';
          bar.style.backgroundColor = 'rgba(239,68,68,0.6)';
          bar.style.width = '100%';
        }
      });

      xhr.addEventListener('error', () => {
        msg.textContent = 'Ağ hatası.';
        msg.className = 'text-[10px] font-bold text-rose-600 mt-1.5 status-msg';
        bar.style.backgroundColor = 'rgba(239,68,68,0.6)';
        bar.style.width = '100%';
      });

      xhr.addEventListener('abort', () => {
        // Item removed by user click
      });

      xhr.open('POST', '/api/cv/upload');
      xhr.send(formData);
    });
  }

  // ─── Init ─────────────────────────────────────────────────────────
  function init() {
    const body = document.getElementById('my-cvs-body');
    if (body && !body.dataset.initialized) {
      body.dataset.initialized = 'true';
      loadCandidates();
      loadCVList();
    }
  }

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'complete' || document.readyState === 'interactive') init();
}
</script>

</AdminLayout>
