---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Beacon - CV Yükle">

  <!-- Page Header -->
  <section class="mb-8">
    <h2 class="font-headline-lg text-headline-lg text-[#1b1c1a] mb-1">CV Yükle ve Analiz Et</h2>
    <p class="font-body-lg text-body-lg text-[#8a8580] max-w-2xl font-medium">Platforma aday adına tekli veya toplu CV yükleyin.</p>
  </section>

  <div class="grid grid-cols-1 xl:grid-cols-[360px_1fr] gap-6 items-start">

    <!-- ─── LEFT COLUMN ─────────────────────────────────────────────── -->
    <div class="flex flex-col gap-3">

      <!-- Candidate Selector -->
      <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm overflow-hidden">
        <!-- Compact gradient header -->
        <div class="relative px-4 py-3.5 overflow-hidden" style="background: linear-gradient(135deg, #14422f 0%, #1e5c42 100%);">
          <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 70% 50%, #fff 1px, transparent 1px); background-size: 16px 16px;"></div>
          <div class="relative flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-[8px] bg-white/15 flex items-center justify-center shrink-0 border border-white/20">
              <span class="material-symbols-outlined text-white text-[16px]">person_search</span>
            </div>
            <div>
              <p class="text-[13px] font-black text-white leading-tight">Aday Seç</p>
              <p class="text-[10px] text-white/60 font-medium">CV kime yüklensin?</p>
            </div>
          </div>
        </div>

        <!-- Body -->
        <div class="p-3 space-y-2">
          <!-- Label + dropdown -->
          <div>
            <p class="text-[9px] font-bold text-[#8a8580] uppercase tracking-widest mb-1">KULLANICI</p>
            <div class="relative">
              <select
                id="admin-candidate-select"
                class="w-full appearance-none bg-[#faf9f5] border border-[#ddd9d3] rounded-[8px] px-3 py-2 pr-9 text-[12px] font-semibold text-[#1b1c1a] focus:outline-none focus:ring-2 focus:ring-[#14422f]/20 focus:border-[#14422f] cursor-pointer transition-all"
              >
                <option value="">Kendi hesabıma yükle (Admin)</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[#8a8580] text-[17px] pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- Selected user row -->
          <div class="flex items-center gap-2.5 bg-[#f5f4f0] border border-[#ddd9d3] rounded-[8px] px-2.5 py-2">
            <div id="selected-user-avatar"
              class="w-8 h-8 rounded-full bg-[#14422f] flex items-center justify-center shrink-0 border-2 border-white shadow-sm">
              <span class="material-symbols-outlined text-white text-[14px]">admin_panel_settings</span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[12px] font-bold text-[#1b1c1a] truncate leading-tight" id="selected-user-name">Admin (Ben)</p>
              <p class="text-[10px] text-[#8a8580] font-medium truncate" id="selected-user-email">Kendi hesabıma yükleniyor</p>
            </div>
            <span class="material-symbols-outlined text-emerald-500 text-[20px] shrink-0">check_circle</span>
          </div>
        </div>
      </div>

      <!-- Upload Card with Tabs -->
      <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm overflow-hidden">

        <!-- Tab Header -->
        <div class="flex border-b border-[#ddd9d3]">
          <button
            id="tab-single"
            class="upload-tab flex-1 flex items-center justify-center gap-1.5 px-3 py-3 text-[11px] font-bold transition-all border-b-2 border-[#14422f] text-[#14422f] bg-[#14422f]/[0.03]"
            data-tab="single"
          >
            <span class="material-symbols-outlined text-[15px]">upload_file</span>
            Tekli Yükleme
          </button>
          <button
            id="tab-bulk"
            class="upload-tab flex-1 flex items-center justify-center gap-1.5 px-3 py-3 text-[11px] font-bold transition-all border-b-2 border-transparent text-[#8a8580] hover:text-[#1b1c1a] hover:bg-[#f5f4f0]"
            data-tab="bulk"
          >
            <span class="material-symbols-outlined text-[15px]">folder_open</span>
            Toplu Yükleme
          </button>
        </div>

        <!-- ── TAB: Tekli Yükleme ── -->
        <div id="panel-single" class="p-3">
          <div
            id="drop-zone-single"
            class="border-2 border-dashed border-[#ddd9d3] rounded-[10px] py-6 px-4 flex flex-col items-center justify-center cursor-pointer hover:border-[#14422f]/40 hover:bg-[#14422f]/[0.02] transition-all duration-200 group"
          >
            <div class="w-10 h-10 rounded-full bg-[#14422f]/8 flex items-center justify-center mb-2.5 border border-[#14422f]/15 group-hover:bg-[#14422f]/[0.12] transition-colors">
              <span class="material-symbols-outlined text-[#14422f] text-[22px]">upload_file</span>
            </div>
            <p class="text-[12px] font-bold text-[#1b1c1a] mb-0.5 text-center">Dosyayı Buraya Sürükleyin</p>
            <p class="text-[10px] text-[#8a8580] font-medium text-center mb-3">Tek PDF · Maks 5MB</p>
            <button class="bg-[#14422f] text-white text-[11px] font-bold px-4 py-2 rounded-[7px] hover:opacity-90 transition-opacity">
              Dosya Seç
            </button>
            <input type="file" id="cv-file-single" accept=".pdf" class="hidden" />
          </div>

          <!-- Single progress -->
          <div id="single-progress-wrap" class="hidden mt-2.5 bg-[#faf9f5] border border-[#ddd9d3] rounded-[8px] p-2.5">
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="material-symbols-outlined text-red-500 text-[15px] shrink-0">picture_as_pdf</span>
                <span id="single-file-name" class="text-[11px] font-bold text-[#1b1c1a] truncate">—</span>
              </div>
              <span id="single-pct" class="text-[11px] font-mono text-[#8a8580] shrink-0">0%</span>
            </div>
            <div class="w-full bg-white border border-[#ddd9d3] h-1 rounded-full overflow-hidden">
              <div id="single-bar" class="h-full w-0 bg-[#14422f] transition-all duration-150 rounded-full"></div>
            </div>
            <p id="single-msg" class="text-[10px] text-[#8a8580] font-medium mt-1">Yükleniyor...</p>
          </div>
        </div>

        <!-- ── TAB: Toplu Yükleme ── -->
        <div id="panel-bulk" class="p-3 hidden">

          <!-- Drop zone -->
          <div
            id="drop-zone-bulk"
            class="border-2 border-dashed border-[#ddd9d3] rounded-[10px] py-5 px-4 flex flex-col items-center justify-center cursor-pointer hover:border-[#14422f]/40 hover:bg-[#14422f]/[0.02] transition-all duration-200 group"
          >
            <div class="w-9 h-9 rounded-full bg-[#14422f]/8 flex items-center justify-center mb-2 border border-[#14422f]/15 group-hover:bg-[#14422f]/[0.12] transition-colors">
              <span class="material-symbols-outlined text-[#14422f] text-[19px]">folder_open</span>
            </div>
            <p class="text-[12px] font-bold text-[#1b1c1a] mb-0.5 text-center">Birden fazla dosya seç</p>
            <p class="text-[10px] text-[#8a8580] font-medium text-center mb-3">Her dosya ayrı bir adaya ait · PDF · Maks 5MB</p>
            <button class="bg-[#14422f] text-white text-[11px] font-bold px-4 py-2 rounded-[7px] hover:opacity-90 transition-opacity">
              Dosyaları Seç
            </button>
            <input type="file" id="cv-file-bulk" accept=".pdf" class="hidden" multiple />
          </div>

          <!-- Queue -->
          <div id="bulk-queue-wrap" class="hidden mt-3">
            <div class="flex items-center justify-between mb-2">
              <p class="text-[9px] font-bold text-[#8a8580] tracking-widest uppercase">YÜKLEME KUYRUĞU</p>
              <button id="clear-done-btn" class="text-[10px] font-bold text-[#8a8580] hover:text-rose-600 transition-colors hidden">
                Temizle
              </button>
            </div>
            <div id="bulk-progress-list" class="space-y-2 mb-3"></div>
            <button
              id="bulk-upload-btn"
              class="w-full bg-[#14422f] text-white text-[11px] font-bold py-2.5 rounded-[8px] hover:opacity-90 transition-opacity flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-[15px]">cloud_upload</span>
              Tümünü Yükle
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- ─── RIGHT COLUMN ────────────────────────────────────────────── -->
    <div class="flex flex-col gap-6">

      <!-- Master CV List Table Card -->
      <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-[#ddd9d3] flex justify-between items-center bg-[#faf9f5]">
          <div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#14422f] text-[18px]">folder_shared</span>
              <h3 class="text-sm font-bold text-[#1b1c1a]">Sistemdeki Tüm Özgeçmişler</h3>
            </div>
            <p class="text-[11px] text-[#8a8580] font-medium mt-0.5">Platform genelinde tüm adaylar tarafından yüklenen CV'lerin listesi (Admin Yönetim Paneli)</p>
          </div>
          <span class="text-xs font-bold text-[#14422f] bg-[#14422f]/10 border border-[#14422f]/20 px-3 py-1 rounded-full shrink-0" id="cv-count-label">0 kayıt</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs whitespace-nowrap">
            <thead class="text-[10px] text-[#8a8580] uppercase bg-[#f5f4f0] border-b border-[#ddd9d3] tracking-wider">
              <tr>
                <th class="px-4 py-3 font-bold">DOSYA ADI</th>
                <th class="px-4 py-3 font-bold">AİT OLDUĞU ADAY</th>
                <th class="px-4 py-3 font-bold">YÜKLEME TARİHİ</th>
                <th class="px-4 py-3 font-bold">DURUM</th>
                <th class="px-4 py-3 font-bold text-right">İŞLEM</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#ddd9d3] text-[#1b1c1a]" id="my-cvs-body">
              <tr>
                <td colspan="5" class="p-8 text-center text-[#8a8580] font-medium text-xs">Yüklemeler getiriliyor...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Chunk Viewer -->
      <div class="hidden" id="chunk-viewer-section">
        <div class="bg-white border border-[#ddd9d3] rounded-[12px] shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-[#ddd9d3] flex items-center gap-3">
            <div class="w-8 h-8 rounded-[8px] bg-[#14422f]/10 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[#14422f] text-[18px]">segment</span>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-[#1b1c1a] truncate" id="chunk-viewer-title">CV Parçaları</p>
              <p class="text-[10px] text-[#8a8580] font-medium" id="chunk-count-label"></p>
            </div>
          </div>
          <div class="p-4 space-y-3 max-h-[480px] overflow-y-auto custom-scrollbar" id="chunk-list"></div>
        </div>
      </div>

    </div>
  </div>

<script is:inline>
{
  let activeCvId = null;
  let activeInterval = null;
  let allCandidates = [];

  // ─── Tab switching ─────────────────────────────────────────────────
  function switchTab(tabName) {
    const tabs = document.querySelectorAll('.upload-tab');
    tabs.forEach(t => {
      const isActive = t.dataset.tab === tabName;
      t.classList.toggle('border-[#14422f]', isActive);
      t.classList.toggle('text-[#14422f]', isActive);
      t.classList.toggle('bg-[#14422f]/[0.03]', isActive);
      t.classList.toggle('border-transparent', !isActive);
      t.classList.toggle('text-[#8a8580]', !isActive);
      t.classList.toggle('hover:text-[#1b1c1a]', !isActive);
      t.classList.toggle('hover:bg-[#f5f4f0]', !isActive);
    });
    document.getElementById('panel-single')?.classList.toggle('hidden', tabName !== 'single');
    document.getElementById('panel-bulk')?.classList.toggle('hidden', tabName !== 'bulk');
  }

  document.getElementById('tab-single')?.addEventListener('click', () => switchTab('single'));
  document.getElementById('tab-bulk')?.addEventListener('click', () => switchTab('bulk'));

  // ─── Candidate selector ────────────────────────────────────────────
  async function loadCandidates() {
    const select = document.getElementById('admin-candidate-select');
    if (!select) return;
    try {
      const res = await fetch('/api/admin/candidates');
      if (!res.ok) throw new Error();
      const data = await res.json();
      allCandidates = data.candidates || [];
      allCandidates.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name ? `${c.name} — ${c.email}` : c.email;
        select.appendChild(opt);
      });
    } catch {}
  }

  function updateSelectedCard() {
    const select = document.getElementById('admin-candidate-select');
    const avatar = document.getElementById('selected-user-avatar');
    const nameEl = document.getElementById('selected-user-name');
    const emailEl = document.getElementById('selected-user-email');
    if (!select) return;
    const val = select.value;
    if (!val) {
      if (avatar) avatar.innerHTML = '<span class="material-symbols-outlined text-white text-[15px]">admin_panel_settings</span>';
      if (nameEl) nameEl.textContent = 'Admin (Ben)';
      if (emailEl) emailEl.textContent = 'Kendi hesabıma yükleniyor';
      return;
    }
    const cand = allCandidates.find(c => c.id === val);
    if (!cand) return;
    const initials = ((cand.name || cand.email) || '?').slice(0, 2).toUpperCase();
    if (avatar) avatar.innerHTML = `<span class="text-xs font-black text-white">${initials}</span>`;
    if (nameEl) nameEl.textContent = cand.name || cand.email;
    if (emailEl) emailEl.textContent = cand.name ? cand.email : '';
  }

  document.getElementById('admin-candidate-select')?.addEventListener('change', updateSelectedCard);

  // ─── Delete CV ─────────────────────────────────────────────────────
  window.deleteCV = async function(cvId) {
    if (!confirm('Bu CV ve tüm ilişkili verileri silmek istediğinize emin misiniz?')) return;
    try {
      const res = await fetch(`/api/cv/${cvId}`, { method: 'DELETE' });
      if (!res.ok) throw new Error((await res.json()).message || 'Silme başarısız.');
      if (activeCvId === cvId) {
        activeCvId = null;
        document.getElementById('chunk-viewer-section')?.classList.add('hidden');
      }
      await loadCVList();
    } catch (err) { alert(err.message); }
  };

  // ─── Retry CV ──────────────────────────────────────────────────────
  window.retryCV = async function(cvId) {
    try {
      const res = await fetch(`/api/cv/${cvId}/retry`, { method: 'POST' });
      if (!res.ok) throw new Error((await res.json()).message || 'Yeniden deneme başarısız.');
      await loadCVList();
    } catch (err) { alert(err.message); }
  };

  // ─── Chunk Viewer ──────────────────────────────────────────────────
  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  async function showChunks(cvId, fileName) {
    activeCvId = cvId;
    const section = document.getElementById('chunk-viewer-section');
    const title = document.getElementById('chunk-viewer-title');
    const countLabel = document.getElementById('chunk-count-label');
    const list = document.getElementById('chunk-list');
    if (!section || !list) return;
    title.textContent = fileName;
    countLabel.textContent = 'Yükleniyor...';
    list.innerHTML = `<div class="flex items-center justify-center py-10 gap-3 text-[#8a8580]"><span class="material-symbols-outlined animate-spin text-2xl">progress_activity</span><span class="text-sm font-medium">Parçalar getiriliyor...</span></div>`;
    section.classList.remove('hidden');
    try {
      const res = await fetch(`/api/cv/${cvId}/chunks`);
      if (!res.ok) throw new Error();
      const data = await res.json();
      const chunks = data.chunks || [];
      countLabel.textContent = `${chunks.length} parça`;
      if (chunks.length === 0) {
        list.innerHTML = `<div class="py-10 text-center text-[#8a8580] text-sm font-medium">Bu CV için henüz parça oluşturulmamış.</div>`;
        return;
      }
      list.innerHTML = '';
      chunks.forEach((chunk, i) => {
        const div = document.createElement('div');
        div.className = 'border border-[#ddd9d3] rounded-[10px] overflow-hidden text-left bg-[#faf9f5]';
        div.innerHTML = `
          <div class="px-4 py-2.5 border-b border-[#ddd9d3] bg-white flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#14422f]/10 text-[10px] font-black text-[#14422f]">${i + 1}</span>
            <span class="text-[11px] font-bold text-[#8a8580] uppercase tracking-wider">Parça ${chunk.chunkIndex}</span>
          </div>
          <div class="px-4 py-3">
            <p class="text-xs text-[#1b1c1a] font-medium leading-relaxed whitespace-pre-wrap break-words">${escapeHtml(chunk.chunkText)}</p>
          </div>
        `;
        list.appendChild(div);
      });
    } catch {
      list.innerHTML = `<div class="py-8 text-center text-rose-600 text-sm font-medium">Parçalar yüklenirken hata oluştu.</div>`;
    }
  }

  // ─── CV List ───────────────────────────────────────────────────────
  async function loadCVList() {
    const tbody = document.getElementById('my-cvs-body');
    const countLabel = document.getElementById('cv-count-label');
    if (!tbody) return;
    try {
      const res = await fetch('/api/cv/list');
      if (!res.ok) throw new Error();
      const data = await res.json();
      const cvs = data.cvs || [];
      if (countLabel) countLabel.textContent = `${cvs.length} kayıt`;
      if (cvs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-10 text-center text-[#8a8580] font-medium text-sm">Henüz CV yüklenmedi.</td></tr>`;
        clearInterval(activeInterval); activeInterval = null; return;
      }
      let hasPending = false;
      tbody.innerHTML = '';
      cvs.forEach(cv => {
        const analysis = cv.analyses?.[0];
        const status = analysis?.status ?? 'PENDING';
        if (status === 'PENDING' || status === 'PROCESSING') hasPending = true;
        const date = new Date(cv.createdAt).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' });
        const badges = {
          PENDING:    `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>Sırada</span>`,
          PROCESSING: `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200"><span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-ping"></span>İşleniyor</span>`,
          COMPLETED:  `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Hazır</span>`,
          FAILED:     `<span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-[6px] text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Hata</span>`,
        };
        const statusBadge = badges[status] ?? '';
        const userText = cv.user ? (cv.user.name || cv.user.email) : 'Admin';
        const retryBtn = status === 'FAILED'
          ? `<button onclick="retryCV('${cv.id}')" class="p-1.5 rounded-[6px] text-amber-600 hover:text-amber-700 hover:bg-amber-50 transition-colors mr-1" title="Tekrar Dene">
               <span class="material-symbols-outlined text-[16px]">refresh</span>
             </button>`
          : '';
        const tr = document.createElement('tr');
        tr.className = `hover:bg-[#f5f4f0]/60 transition-colors cursor-pointer ${activeCvId === cv.id ? 'bg-[#f5f4f0]' : ''}`;
        tr.onclick = () => {
          activeCvId = cv.id;
          document.querySelectorAll('#my-cvs-body tr').forEach(r => r.classList.remove('bg-[#f5f4f0]'));
          tr.classList.add('bg-[#f5f4f0]');
          showChunks(cv.id, cv.fileName);
        };
        tr.innerHTML = `
          <td class="px-4 py-3"><div class="flex items-center gap-2.5"><span class="material-symbols-outlined text-red-500 text-[18px] shrink-0">picture_as_pdf</span><span class="text-xs font-bold text-[#1b1c1a] truncate max-w-[200px]">${cv.fileName}</span></div></td>
          <td class="px-4 py-3 text-[11px] text-[#8a8580] font-semibold truncate max-w-[130px]">${userText}</td>
          <td class="px-4 py-3 text-[11px] text-[#8a8580] font-medium whitespace-nowrap">${date}</td>
          <td class="px-4 py-3">${statusBadge}</td>
          <td class="px-4 py-3 text-right" onclick="event.stopPropagation()">
            ${retryBtn}
            <button onclick="deleteCV('${cv.id}')" class="p-1.5 rounded-[6px] text-[#8a8580] hover:text-rose-600 hover:bg-rose-50 transition-colors" title="Sil">
              <span class="material-symbols-outlined text-[16px]">delete</span>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
      if (hasPending && !activeInterval) activeInterval = setInterval(loadCVList, 3000);
      else if (!hasPending && activeInterval) { clearInterval(activeInterval); activeInterval = null; }
    } catch {
      tbody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-rose-600 text-sm font-medium">Liste yüklenirken hata oluştu.</td></tr>`;
    }
  }

  // ─── Upload helpers ─────────────────────────────────────────────────
  function getTargetUserId() {
    return document.getElementById('admin-candidate-select')?.value || '';
  }

  function validateFile(file) {
    if (file.type !== 'application/pdf') { alert(`Geçersiz dosya: ${file.name}. Sadece PDF yüklenebilir.`); return false; }
    if (file.size > 5 * 1024 * 1024) { alert(`Dosya boyutu fazla: ${file.name} (Maks 5MB)`); return false; }
    return true;
  }

  function uploadXHR(file, { onProgress, onSuccess, onError }) {
    const formData = new FormData();
    formData.append('cv', file);
    const uid = getTargetUserId();
    if (uid) formData.append('targetUserId', uid);
    const xhr = new XMLHttpRequest();
    xhr.upload.addEventListener('progress', e => { if (e.lengthComputable) onProgress(Math.round((e.loaded / e.total) * 100)); });
    xhr.addEventListener('load', () => {
      if (xhr.status >= 200 && xhr.status < 300) onSuccess(JSON.parse(xhr.responseText));
      else { let m = 'Yükleme başarısız.'; try { m = JSON.parse(xhr.responseText).message || m; } catch {} onError(m); }
    });
    xhr.addEventListener('error', () => onError('Ağ hatası.'));
    xhr.open('POST', '/api/cv/upload');
    xhr.send(formData);
    return xhr;
  }

  // ─── Tekli Yükleme ─────────────────────────────────────────────────
  function setupSingleUpload() {
    const dz = document.getElementById('drop-zone-single');
    const input = document.getElementById('cv-file-single');
    const wrap = document.getElementById('single-progress-wrap');
    const fnEl = document.getElementById('single-file-name');
    const bar  = document.getElementById('single-bar');
    const pct  = document.getElementById('single-pct');
    const msg  = document.getElementById('single-msg');

    function doUpload(file) {
      if (!validateFile(file)) return;
      // Reset UI
      fnEl.textContent = file.name;
      bar.style.width = '0%';
      bar.style.backgroundColor = '';
      pct.textContent = '0%';
      msg.textContent = 'Yükleniyor...';
      msg.className = 'text-[10px] text-[#8a8580] font-medium mt-1.5';
      wrap.classList.remove('hidden');

      uploadXHR(file, {
        onProgress: p => { bar.style.width = p + '%'; pct.textContent = p + '%'; if (p === 100) msg.textContent = 'Sunucuya ulaştı...'; },
        onSuccess: () => {
          bar.style.width = '100%'; pct.textContent = '100%';
          msg.textContent = 'Yüklendi! Analiz sıraya alındı.';
          msg.className = 'text-[10px] font-bold text-emerald-600 mt-1.5';
          loadCVList();
        },
        onError: m => {
          msg.textContent = 'Hata: ' + m;
          msg.className = 'text-[10px] font-bold text-rose-600 mt-1.5';
          bar.style.backgroundColor = 'rgba(239,68,68,0.5)';
          bar.style.width = '100%';
        }
      });
    }

    dz?.addEventListener('click', () => input?.click());
    dz?.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-[#14422f]','bg-[#14422f]/[0.03]'); });
    dz?.addEventListener('dragleave', () => dz.classList.remove('border-[#14422f]','bg-[#14422f]/[0.03]'));
    dz?.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-[#14422f]','bg-[#14422f]/[0.03]'); if (e.dataTransfer?.files?.[0]) doUpload(e.dataTransfer.files[0]); });
    input?.addEventListener('change', () => { if (input.files?.[0]) doUpload(input.files[0]); });
  }

  // ─── Toplu Yükleme ───────────────────────────────────────────
  // Her dosya farklı bir adaya ait — her satır kendi dropdown'ını taşır
  function setupBulkUpload() {
    const dz       = document.getElementById('drop-zone-bulk');
    const input    = document.getElementById('cv-file-bulk');
    const wrap     = document.getElementById('bulk-queue-wrap');
    const list     = document.getElementById('bulk-progress-list');
    const clearBtn = document.getElementById('clear-done-btn');
    const uploadAllBtn = document.getElementById('bulk-upload-btn');

    // ── Akıllı dosya adı → aday eşleştirme ──
    function parseNameFromFilename(filename) {
      // Remove extension
      let name = filename.replace(/\.[^.]+$/, '');
      // Remove common CV keywords (TR + EN)
      name = name.replace(/\b(cv|resume|ozgecmis|özgec&#51;mis|portfolio|staj|intern|application|basvuru|2024|2025|2026|final|v\d+|\d+)\b/gi, '');
      // Replace separators with space
      name = name.replace(/[_\-\.]+/g, ' ').trim();
      // Collapse multiple spaces
      name = name.replace(/\s+/g, ' ').trim();
      return name.length >= 2 ? name : null;
    }

    function normalize(str) {
      return (str || '')
        .toLowerCase()
        .replace(/ı/g, 'i').replace(/ş/g,'s').replace(/ç/g,'c').replace(/ö/g,'o').replace(/ü/g,'u').replace(/ğ/g,'g')
        .replace(/[^a-z0-9 ]/g, '')
        .trim();
    }

    function findBestMatch(parsedName) {
      if (!parsedName || !allCandidates.length) return null;
      const normParsed = normalize(parsedName);
      const parsedTokens = normParsed.split(' ').filter(t => t.length > 1);
      if (!parsedTokens.length) return null;

      let best = null;
      let bestScore = 0;

      allCandidates.forEach(cand => {
        const normName = normalize(cand.name || cand.email.split('@')[0]);
        const nameTokens = normName.split(' ');

        // Count how many parsed tokens appear in the candidate name
        const matchedTokens = parsedTokens.filter(pt =>
          nameTokens.some(nt => nt.includes(pt) || pt.includes(nt))
        );
        const score = matchedTokens.length / Math.max(parsedTokens.length, nameTokens.length);

        // Also check full string containment
        const containsScore = normName.includes(normParsed) || normParsed.includes(normName) ? 0.9 : 0;
        const finalScore = Math.max(score, containsScore);

        if (finalScore > bestScore) {
          bestScore = finalScore;
          best = { candidate: cand, score: finalScore };
        }
      });

      return bestScore >= 0.6 ? best : null;
    }

    // Build candidate option HTML
    function buildOptions(preSelectedId = '') {
      let opts = `<option value=""${!preSelectedId ? ' selected' : ''}>Admin (kendi hesabıma)</option>`;
      allCandidates.forEach(c => {
        const label = c.name ? `${c.name} \u2014 ${c.email}` : c.email;
        opts += `<option value="${c.id}"${c.id === preSelectedId ? ' selected' : ''}>${label}</option>`;
      });
      return opts;
    }

    clearBtn?.addEventListener('click', () => {
      list?.querySelectorAll('.bulk-item.done').forEach(el => el.remove());
      if (!list?.children.length) { wrap.classList.add('hidden'); clearBtn.classList.add('hidden'); }
    });

    // Add files to queue (without uploading yet)
    function addToQueue(files) {
      wrap.classList.remove('hidden');
      uploadAllBtn.disabled = false;
      uploadAllBtn.classList.remove('opacity-50', 'cursor-not-allowed');

      Array.from(files).forEach(file => {
        if (!validateFile(file)) return;

        // Smart match
        const parsedName = parseNameFromFilename(file.name);
        const match = findBestMatch(parsedName);
        const matchedId = match ? match.candidate.id : '';
        const matchedName = match ? (match.candidate.name || match.candidate.email) : '';
        const confidence = match ? Math.round(match.score * 100) : 0;

        // Badge HTML
        const badgeHtml = match
          ? `<span class="match-badge inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-[9px] font-bold text-emerald-700">
               <span class="material-symbols-outlined text-[10px]">auto_awesome</span>
               Önerilen · ${confidence}%
             </span>`
          : `<span class="match-badge inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-[9px] font-bold text-amber-700">
               <span class="material-symbols-outlined text-[10px]">help</span>
               Manuel Seç
             </span>`;

        const item = document.createElement('div');
        item.className = 'bulk-item bg-[#faf9f5] border border-[#ddd9d3] rounded-[10px] overflow-hidden';
        item.dataset.state = 'queued';
        item.innerHTML = `
          <!-- File info row -->
          <div class="flex items-center gap-2 px-3 pt-3 pb-1.5">
            <span class="material-symbols-outlined text-red-500 text-[16px] shrink-0">picture_as_pdf</span>
            <span class="text-[11px] font-bold text-[#1b1c1a] truncate flex-1">${file.name}</span>
            ${badgeHtml}
            <button class="remove-btn w-5 h-5 rounded-full flex items-center justify-center text-[#8a8580] hover:text-rose-600 hover:bg-rose-50 transition-colors shrink-0 ml-1" title="Kuyruktan \u00e7\u0131kar">
              <span class="material-symbols-outlined text-[14px]">close</span>
            </button>
          </div>
          <!-- Candidate dropdown -->
          <div class="px-3 pb-2">
            <div class="relative">
              <select class="row-candidate w-full appearance-none rounded-[7px] px-3 py-2 pr-8 text-[11px] font-medium focus:outline-none focus:border-[#14422f] cursor-pointer transition-all
                ${match
                  ? 'bg-emerald-50 border border-emerald-200 text-emerald-800'
                  : 'bg-white border border-amber-300 text-[#1b1c1a]'}">
                ${buildOptions(matchedId)}
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[#8a8580] text-[14px] pointer-events-none">expand_more</span>
            </div>
            ${match ? `<p class="text-[9px] text-emerald-600 font-medium mt-0.5 px-1">&#8599; "${parsedName}" \u2192 ${matchedName}</p>` : '<p class="text-[9px] text-amber-600 font-medium mt-0.5 px-1">Dosya ad\u0131ndan e\u015fle\u015fme bulunamad\u0131 \u2014 l\u00fctfen elle se\u00e7in</p>'}
          </div>
          <!-- Progress (hidden until upload starts) -->
          <div class="progress-area hidden px-3 pb-3">
            <div class="w-full bg-white border border-[#ddd9d3] h-1.5 rounded-full overflow-hidden mb-1">
              <div class="h-full w-0 bg-[#14422f] transition-all duration-150 rounded-full item-bar"></div>
            </div>
            <div class="flex items-center justify-between">
              <p class="text-[10px] font-medium item-msg text-[#8a8580]">Bekliyor...</p>
              <span class="text-[10px] font-mono text-[#8a8580] item-pct">0%</span>
            </div>
          </div>
        `;
        list.appendChild(item);

        // Remove from queue
        item.querySelector('.remove-btn').addEventListener('click', () => {
          item.remove();
          if (!list.children.length) { wrap.classList.add('hidden'); uploadAllBtn.disabled = true; }
        });
      });
    }

    // Upload all queued items
    uploadAllBtn?.addEventListener('click', () => {
      const queued = Array.from(list.querySelectorAll('.bulk-item[data-state="queued"]'));
      if (!queued.length) return;

      uploadAllBtn.disabled = true;
      uploadAllBtn.classList.add('opacity-50', 'cursor-not-allowed');

      // We need to re-get files from the input — we store file refs on the DOM
      queued.forEach(item => {
        item.dataset.state = 'uploading';
        const candidateId = item.querySelector('.row-candidate')?.value || '';
        item.querySelector('.row-candidate')?.closest('div.px-3')?.classList.add('hidden');
        item.querySelector('.progress-area')?.classList.remove('hidden');
        item.querySelector('.remove-btn')?.classList.add('hidden');

        const bar = item.querySelector('.item-bar');
        const pct = item.querySelector('.item-pct');
        const msg = item.querySelector('.item-msg');
        const fileObj = item.__file;

        if (!fileObj) { msg.textContent = 'Dosya bulunamadı.'; return; }

        const formData = new FormData();
        formData.append('cv', fileObj);
        if (candidateId) formData.append('targetUserId', candidateId);

        const xhr = new XMLHttpRequest();
        xhr.upload.addEventListener('progress', e => {
          if (!e.lengthComputable) return;
          const p = Math.round((e.loaded / e.total) * 100);
          bar.style.width = p + '%';
          pct.textContent = p + '%';
          if (p === 100) msg.textContent = 'Sunucuya ulaştı...';
        });
        xhr.addEventListener('load', () => {
          item.dataset.state = 'done';
          item.classList.add('done');
          if (xhr.status >= 200 && xhr.status < 300) {
            bar.style.width = '100%'; pct.textContent = '100%';
            msg.textContent = 'Yüklendi!';
            msg.className = 'text-[10px] font-bold text-emerald-600 item-msg';
            clearBtn.classList.remove('hidden');
            loadCVList();
          } else {
            let m = 'Yükleme başarısız.';
            try { m = JSON.parse(xhr.responseText).message || m; } catch {}
            msg.textContent = 'Hata: ' + m;
            msg.className = 'text-[10px] font-bold text-rose-600 item-msg';
            bar.style.backgroundColor = 'rgba(239,68,68,0.5)';
            bar.style.width = '100%';
            clearBtn.classList.remove('hidden');
          }
        });
        xhr.open('POST', '/api/cv/upload');
        xhr.send(formData);
      });
    });

    // File select & drop handlers — store file refs on DOM nodes
    function handleFiles(files) {
      addToQueue(files);
      // Attach file objects to the newly added rows
      const rows = Array.from(list.querySelectorAll('.bulk-item[data-state="queued"]'));
      const newRows = rows.slice(-files.length);
      Array.from(files).forEach((f, i) => { if (newRows[i]) newRows[i].__file = f; });
    }

    dz?.addEventListener('click', () => input?.click());
    dz?.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-[#14422f]','bg-[#14422f]/[0.03]'); });
    dz?.addEventListener('dragleave', () => dz.classList.remove('border-[#14422f]','bg-[#14422f]/[0.03]'));
    dz?.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-[#14422f]','bg-[#14422f]/[0.03]'); if (e.dataTransfer?.files?.length) handleFiles(e.dataTransfer.files); });
    input?.addEventListener('change', () => { if (input.files?.length) handleFiles(input.files); });
  }

  // ─── Init ──────────────────────────────────────────────────────────
  function init() {
    const body = document.getElementById('my-cvs-body');
    if (body && !body.dataset.initialized) {
      body.dataset.initialized = 'true';
      loadCandidates();
      loadCVList();
      setupSingleUpload();
      setupBulkUpload();
    }
  }

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'complete' || document.readyState === 'interactive') init();
}
</script>

</AdminLayout>
