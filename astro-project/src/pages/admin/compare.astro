---
import AdminLayout from '../../layouts/AdminLayout.astro';

const candidate1Id = Astro.url.searchParams.get('candidate1') || '';
const candidate2Id = Astro.url.searchParams.get('candidate2') || '';
---

<AdminLayout title="Beacon - Aday Karşılaştırma">
  <!-- Back Button & Page Header -->
  <header class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <a href="/admin/search" class="inline-flex items-center gap-2 text-xs font-bold text-[#8a8580] hover:text-[#14422f] transition-colors mb-3 uppercase tracking-wider">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span> Arama Ekranına Dön
      </a>
      <h2 class="font-headline-md text-headline-md font-bold mb-2 text-[#1b1c1a] text-3xl">Aday Karşılaştırma Paneli</h2>
      <p class="font-body-sm text-sm text-[#8a8580] font-medium" id="compare-subtitle">İki adayı yan yana yetenek, deneyim ve AI analizleriyle kıyaslayın.</p>
    </div>
  </header>

  <!-- Loading State -->
  <div id="compare-loading" class="bg-white border border-[#ddd9d3] rounded-[10px] p-16 flex flex-col items-center justify-center text-center shadow-sm">
    <span class="material-symbols-outlined text-4xl text-[#14422f] animate-spin mb-4">progress_activity</span>
    <h3 class="font-bold text-[#1b1c1a] text-lg">Aday Bilgileri Kıyaslanıyor...</h3>
    <p class="text-xs text-[#8a8580] max-w-sm mt-1">Seçilen adayların verileri ve yapay zeka analizleri hazırlanıyor.</p>
  </div>

  <!-- Error State -->
  <div id="compare-error" class="hidden bg-rose-50 border border-rose-200 rounded-[10px] p-12 text-center text-rose-800 shadow-sm flex-col items-center justify-center">
    <span class="material-symbols-outlined text-5xl text-rose-600 mb-3">group_off</span>
    <h3 class="font-bold text-lg text-rose-900" id="compare-error-title">Karşılaştırma Yapılamadı</h3>
    <p class="text-xs text-rose-600 max-w-md mt-1" id="compare-error-desc">Karşılaştırılacak geçerli 2 aday seçilmedi veya aday verileri okunamadı.</p>
    <a href="/admin/search" class="mt-6 bg-[#14422f] text-white px-6 py-2.5 rounded-lg text-xs font-bold hover:bg-[#0f3223] transition-colors inline-flex items-center gap-2">
      <span class="material-symbols-outlined text-sm">search</span> Aday Listesine Git
    </a>
  </div>

  <!-- Split-Screen Grid Comparison Layout -->
  <div id="compare-grid" class="hidden grid-cols-1 lg:grid-cols-2 gap-8 items-start" data-c1={candidate1Id} data-c2={candidate2Id}>
    
    <!-- Candidate 1 Column -->
    <div id="cand1-card" class="flex flex-col gap-6 w-full"></div>

    <!-- Candidate 2 Column -->
    <div id="cand2-card" class="flex flex-col gap-6 w-full"></div>

  </div>

  <script is:inline data-astro-rerun>
    async function loadComparisonData() {
      const grid = document.getElementById('compare-grid');
      const loading = document.getElementById('compare-loading');
      const errorDiv = document.getElementById('compare-error');
      if (!grid || !loading || !errorDiv) return;

      const c1Id = grid.dataset.c1;
      const c2Id = grid.dataset.c2;

      if (!c1Id || !c2Id) {
        loading.classList.add('hidden');
        errorDiv.classList.remove('hidden');
        errorDiv.classList.add('flex');
        document.getElementById('compare-error-desc').textContent = 'Karşılaştırma yapabilmek için lütfen arama sayfasından 2 adet aday seçin.';
        return;
      }

      try {
        const [res1, res2] = await Promise.all([
          fetch(`/api/admin/candidates/${c1Id}`),
          fetch(`/api/admin/candidates/${c2Id}`)
        ]);

        if (!res1.ok || !res2.ok) {
          throw new Error("Aday verileri sunucudan okunamadı.");
        }

        const data1 = await res1.json();
        const data2 = await res2.json();

        const cand1 = data1.candidate;
        const cand2 = data2.candidate;

        loading.classList.add('hidden');
        grid.classList.remove('hidden');
        grid.classList.add('grid');

        renderCandidateColumn('cand1-card', cand1);
        renderCandidateColumn('cand2-card', cand2);

      } catch (err) {
        console.error("Comparison load error:", err);
        loading.classList.add('hidden');
        errorDiv.classList.remove('hidden');
        errorDiv.classList.add('flex');
      }
    }

    function renderCandidateColumn(containerId, candidate) {
      const container = document.getElementById(containerId);
      if (!container || !candidate) return;

      const initials = (candidate.name || candidate.email || '??').substring(0, 2).toUpperCase();
      const createdDate = new Date(candidate.createdAt).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

      // Get latest CV and analysis
      const latestCv = candidate.cvs && candidate.cvs[0];
      const latestAnalysis = latestCv && latestCv.analyses && latestCv.analyses[0];

      const score = latestAnalysis && latestAnalysis.atsScore !== null ? latestAnalysis.atsScore : null;
      const strengths = latestAnalysis && latestAnalysis.strengths ? latestAnalysis.strengths : [];
      const weaknesses = latestAnalysis && latestAnalysis.weaknesses ? latestAnalysis.weaknesses : [];
      const skills = (latestAnalysis && latestAnalysis.skills) || candidate.skills || [];

      // Color themes based on score
      const scoreColorClass = score >= 80 ? 'bg-emerald-600' : score >= 60 ? 'bg-amber-500' : 'bg-rose-500';
      const scoreBadgeClass = score >= 80 ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : score >= 60 ? 'bg-amber-50 text-amber-700 border-amber-200' : 'bg-rose-50 text-rose-700 border-rose-200';

      const avatarHtml = candidate.avatarUrl
        ? `<div class="w-16 h-16 rounded-full border border-[#ddd9d3] bg-cover bg-center shrink-0" style="background-image: url('${candidate.avatarUrl}')"></div>`
        : `<div class="w-16 h-16 rounded-full bg-[#14422f]/10 text-[#14422f] border border-[#ddd9d3] flex items-center justify-center font-bold text-xl shrink-0">${initials}</div>`;

      container.innerHTML = `
        <!-- Header Info Card -->
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 shadow-sm relative overflow-hidden">
          <div class="absolute left-0 top-0 bottom-0 w-[4px] bg-[#14422f]"></div>
          <div class="flex justify-between items-start mb-4">
            <div class="flex items-center gap-4">
              ${avatarHtml}
              <div>
                <h3 class="font-bold text-[#1b1c1a] text-lg">${candidate.name || 'İsimsiz Aday'}</h3>
                <p class="text-xs text-[#8a8580] font-medium mt-0.5">${candidate.email}</p>
                <p class="text-xs text-[#8a8580] mt-1 flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px]">call</span> ${candidate.phone || 'Telefon belirtilmemiş'}
                </p>
              </div>
            </div>
          </div>
          <div class="flex items-center justify-between pt-4 border-t border-[#ddd9d3] text-xs text-[#8a8580]">
            <span>Kayıt Tarihi: <strong class="text-[#1b1c1a]">${createdDate}</strong></span>
            <a href="/admin/profile?userId=${candidate.id}" class="text-[#14422f] hover:underline font-bold inline-flex items-center gap-1">
              Tam Profil <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- ATS Match Score Card -->
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 shadow-sm">
          <div class="flex justify-between items-center mb-3">
            <span class="text-xs font-bold text-[#8a8580] uppercase tracking-wider">ATS UYUM SKORU</span>
            ${score !== null 
              ? `<span class="px-3 py-1 rounded-full text-xs font-bold border ${scoreBadgeClass}">%${score} Uyum</span>`
              : `<span class="text-xs text-[#8a8580] italic">Analiz Yok</span>`}
          </div>
          ${score !== null ? `
            <div class="w-full bg-[#faf9f5] border border-[#ddd9d3] rounded-full h-3 overflow-hidden">
              <div class="h-full rounded-full ${scoreColorClass} transition-all duration-500" style="width: ${score}%"></div>
            </div>
          ` : ''}
        </div>

        <!-- Strengths Card -->
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 shadow-sm flex flex-col gap-3">
          <h4 class="text-xs font-bold text-emerald-800 uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600 text-[18px]">thumb_up</span>
            Güçlü Yönler (Strengths)
          </h4>
          ${strengths.length > 0 ? `
            <ul class="space-y-2">
              ${strengths.map(s => `
                <li class="flex items-start gap-2 text-xs text-[#1b1c1a] leading-relaxed bg-emerald-50/60 border border-emerald-100 p-2.5 rounded-lg">
                  <span class="material-symbols-outlined text-emerald-600 text-[15px] shrink-0 mt-0.5">check_circle</span>
                  <span>${s}</span>
                </li>
              `).join('')}
            </ul>
          ` : `<p class="text-xs text-[#8a8580] italic">Güçlü yön verisi bulunamadı.</p>`}
        </div>

        <!-- Weaknesses & Gaps Card -->
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 shadow-sm flex flex-col gap-3">
          <h4 class="text-xs font-bold text-rose-800 uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-rose-600 text-[18px]">build</span>
            Gelişime Açık Yönler (Gaps)
          </h4>
          ${weaknesses.length > 0 ? `
            <ul class="space-y-2">
              ${weaknesses.map(w => `
                <li class="flex items-start gap-2 text-xs text-[#1b1c1a] leading-relaxed bg-rose-50/60 border border-rose-100 p-2.5 rounded-lg">
                  <span class="material-symbols-outlined text-rose-600 text-[15px] shrink-0 mt-0.5">warning</span>
                  <span>${w}</span>
                </li>
              `).join('')}
            </ul>
          ` : `<p class="text-xs text-[#8a8580] italic">Gelişim alanı verisi bulunamadı.</p>`}
        </div>

        <!-- Interview Questions / Suggestions Card -->
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 shadow-sm flex flex-col gap-3">
          <h4 class="text-xs font-bold text-[#14422f] uppercase tracking-wider flex items-center gap-2">
            <span class="material-symbols-outlined text-[#14422f] text-[18px]">quiz</span>
            Mülakat Önerileri & Sorular
          </h4>
          ${suggestions.length > 0 ? `
            <ul class="space-y-2">
              ${suggestions.map(sug => `
                <li class="flex items-start gap-2 text-xs text-[#1b1c1a] leading-relaxed bg-[#faf9f5] border border-[#ddd9d3] p-2.5 rounded-lg">
                  <span class="material-symbols-outlined text-[#14422f] text-[15px] shrink-0 mt-0.5">help_outline</span>
                  <span>${sug}</span>
                </li>
              `).join('')}
            </ul>
          ` : `<p class="text-xs text-[#8a8580] italic">Mülakat önerisi bulunamadı.</p>`}
        </div>

        <!-- Skills Breakdown Card -->
        <div class="bg-white border border-[#ddd9d3] rounded-[10px] p-6 shadow-sm flex flex-col gap-3">
          <h4 class="text-xs font-bold text-[#8a8580] uppercase tracking-wider">Öne Çıkan Yetenekler</h4>
          ${skills.length > 0 ? `
            <div class="flex flex-wrap gap-2">
              ${skills.map(sk => `<span class="bg-[#14422f]/10 text-[#14422f] border border-[#14422f]/20 px-3 py-1 rounded-full text-xs font-semibold">${sk}</span>`).join('')}
            </div>
          ` : `<p class="text-xs text-[#8a8580] italic">Yetenek verisi bulunamadı.</p>`}
        </div>
      `;
    }

    if (!window.__compareListenerRegistered) {
      window.__compareListenerRegistered = true;
      document.addEventListener('astro:page-load', () => {
        const grid = document.getElementById('compare-grid');
        if (grid) loadComparisonData();
      });
    }
  </script></AdminLayout>
