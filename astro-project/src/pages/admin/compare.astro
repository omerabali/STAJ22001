---
import AdminLayout from '../../layouts/AdminLayout.astro';

const candidate1Id = Astro.url.searchParams.get('candidate1') || '';
const candidate2Id = Astro.url.searchParams.get('candidate2') || '';
---

<AdminLayout title="Beacon - Aday Karşılaştırma">
  <!-- Back Button & Page Header -->
  <header class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <a href="/admin/search" class="inline-flex items-center gap-2 text-xs font-bold text-[#8a8580] hover:text-[#14422f] transition-colors mb-3 uppercase tracking-wider">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span> Arama Ekranına Dön
      </a>
      <h2 class="font-headline-md text-headline-md font-bold mb-2 text-[#1b1c1a] text-3xl">Aday Karşılaştırma Paneli</h2>
      <p class="font-body-sm text-sm text-[#8a8580] font-medium" id="compare-subtitle">İki adayı yan yana yetenek, deneyim ve AI analizleriyle kıyaslayın.</p>
    </div>
  </header>

  <!-- Candidate Selector Header Card -->
  <div class="bg-white border border-[#ddd9d3] rounded-[12px] p-5 mb-8 shadow-sm">
    <div class="flex flex-col md:flex-row items-center gap-4">
      <div class="flex-1 w-full">
        <label class="text-[10px] font-bold text-[#8a8580] uppercase tracking-wider block mb-1.5">1. ADAY</label>
        <div class="relative">
          <select id="select-cand-1" class="w-full appearance-none bg-[#faf9f5] border border-[#ddd9d3] rounded-[8px] px-3.5 py-2.5 pr-9 text-xs font-bold text-[#1b1c1a] focus:outline-none focus:ring-2 focus:ring-[#14422f]/20 focus:border-[#14422f] cursor-pointer">
            <option value="">1. Adayı Seçin...</option>
          </select>
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#8a8580] text-[18px] pointer-events-none">expand_more</span>
        </div>
      </div>

      <div class="hidden md:flex items-center justify-center w-10 h-10 rounded-full bg-[#14422f]/10 text-[#14422f] shrink-0 mt-5 border border-[#14422f]/20">
        <span class="material-symbols-outlined text-[20px]">compare_arrows</span>
      </div>

      <div class="flex-1 w-full">
        <label class="text-[10px] font-bold text-[#8a8580] uppercase tracking-wider block mb-1.5">2. ADAY</label>
        <div class="relative">
          <select id="select-cand-2" class="w-full appearance-none bg-[#faf9f5] border border-[#ddd9d3] rounded-[8px] px-3.5 py-2.5 pr-9 text-xs font-bold text-[#1b1c1a] focus:outline-none focus:ring-2 focus:ring-[#14422f]/20 focus:border-[#14422f] cursor-pointer">
            <option value="">2. Adayı Seçin...</option>
          </select>
          <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#8a8580] text-[18px] pointer-events-none">expand_more</span>
        </div>
      </div>

      <button id="run-compare-btn" class="w-full md:w-auto mt-2 md:mt-5 bg-[#14422f] hover:bg-[#0f3223] text-white px-6 py-2.5 rounded-[8px] text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-2 shrink-0 cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">bolt</span>
        Kıyasla
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div id="compare-loading" class="hidden w-full bg-white border border-[#ddd9d3] rounded-[10px] p-16 flex-col items-center justify-center text-center shadow-sm">
    <span class="material-symbols-outlined text-4xl text-[#14422f] animate-spin mb-4">progress_activity</span>
    <h3 class="font-bold text-[#1b1c1a] text-lg">Aday Bilgileri Kıyaslanıyor...</h3>
    <p class="text-xs text-[#8a8580] max-w-sm mt-1">Seçilen adayların verileri ve yapay zeka analizleri hazırlanıyor.</p>
  </div>

  <!-- Empty / Select Prompt State -->
  <div id="compare-prompt" class="w-full bg-white border border-[#ddd9d3] rounded-[16px] p-12 md:p-16 flex flex-col items-center justify-center text-center shadow-xs">
    <div class="w-16 h-16 rounded-2xl bg-[#14422f]/10 text-[#14422f] flex items-center justify-center mb-4 border border-[#14422f]/20 shadow-2xs">
      <span class="material-symbols-outlined text-3xl">compare_arrows</span>
    </div>
    <h3 class="font-extrabold text-[#1b1c1a] text-xl tracking-tight">Karşılaştırma İçin Adayları Seçin</h3>
  </div>

  <!-- Error State -->
  <div id="compare-error" class="hidden w-full bg-rose-50 border border-rose-200 rounded-[10px] p-12 text-center text-rose-800 shadow-sm flex flex-col items-center justify-center">
    <span class="material-symbols-outlined text-5xl text-rose-600 mb-3">group_off</span>
    <h3 class="font-bold text-lg text-rose-900" id="compare-error-title">Karşılaştırma Yapılamadı</h3>
    <p class="text-xs text-rose-600 max-w-md mt-1 font-medium" id="compare-error-desc">Karşılaştırılacak geçerli 2 aday seçilmedi veya aday verileri okunamadı.</p>
    <a href="/admin/search" class="mt-6 bg-[#14422f] text-white px-6 py-2.5 rounded-lg text-xs font-bold hover:bg-[#0f3223] transition-colors inline-flex items-center gap-2">
      <span class="material-symbols-outlined text-sm">search</span> Aday Listesine Git
    </a>
  </div>

  <!-- Split-Screen Grid Comparison Layout -->
  <div id="compare-grid" class="hidden grid-cols-1 lg:grid-cols-2 gap-8 items-start" data-c1={candidate1Id} data-c2={candidate2Id}>
    
    <!-- Candidate 1 Column -->
    <div id="cand1-card" class="flex flex-col gap-6 w-full"></div>

    <!-- Candidate 2 Column -->
    <div id="cand2-card" class="flex flex-col gap-6 w-full"></div>

  </div>

  <script>
    import { loadComparisonData } from '../../scripts/admin/compare/comparePageInit';
    import { clearSemanticSearchCache } from '../../scripts/admin/search/semanticSearchEngine';

    document.addEventListener('astro:page-load', () => {
      clearSemanticSearchCache();
      if (document.getElementById('compare-grid')) {
        loadComparisonData();
      }
    });
  </script>
</AdminLayout>