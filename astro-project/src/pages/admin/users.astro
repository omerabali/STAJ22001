---
import AdminLayout from '../../layouts/AdminLayout.astro';
const { user } = Astro.locals;
---

<AdminLayout title="Beacon - Kullanıcı Yönetimi">
  <div id="users-page-container" data-current-user-id={user?.id}></div>

  <!-- Top Header -->
  <header class="mb-8">
    <h2 class="font-headline-md text-headline-md font-bold mb-2 text-[#1b1c1a]">Kullanıcı Yönetimi</h2>
    <p class="font-body-md text-body-md text-[#8a8580]">Sistemdeki kullanıcıları listeleyin ve rollerini yönetin.</p>
  </header>

  <!-- Stats Row (Admin Dashboard ile Tam Aynı Birebir Kart Yapısı) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Stat Card 1: Aktif Adaylar -->
    <div class="bg-white rounded-[10px] p-6 shadow-sm border border-[#ddd9d3] border-l-[3px] border-l-[#14422f] hover:shadow-md transition-all duration-200 cursor-pointer group">
      <div class="flex justify-between items-start mb-4">
        <div class="flex flex-col">
          <span class="font-label-md text-xs font-semibold text-[#8a8580] uppercase mb-1">Aktif Adaylar</span>
          <span id="stat-candidates" class="font-display-lg text-3xl text-[#1b1c1a] font-light tracking-tight group-hover:text-[#14422f] transition-colors">-</span>
        </div>
        <div class="w-10 h-10 rounded-full bg-[#14422f]/10 flex items-center justify-center text-[#14422f]">
          <span class="material-symbols-outlined">person_search</span>
        </div>
      </div>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-xs text-[#8a8580] font-medium flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Sistemdeki CV sahibi aday havuzu
        </span>
      </div>
    </div>
    
    <!-- Stat Card 2: Toplam Yöneticiler -->
    <div class="bg-white rounded-[10px] p-6 shadow-sm border border-[#ddd9d3] hover:shadow-md transition-all duration-200 cursor-pointer group">
      <div class="flex justify-between items-start mb-4">
        <div class="flex flex-col">
          <span class="font-label-md text-xs font-semibold text-[#8a8580] uppercase mb-1">Toplam Yöneticiler</span>
          <span id="stat-admins" class="font-display-lg text-3xl text-[#1b1c1a] font-light tracking-tight group-hover:text-[#14422f] transition-colors">-</span>
        </div>
        <div class="w-10 h-10 rounded-full bg-[#f5f4f0] flex items-center justify-center text-[#8a8580]">
          <span class="material-symbols-outlined">badge</span>
        </div>
      </div>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-xs text-[#8a8580] font-medium flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm text-[#14422f]">admin_panel_settings</span>
          Sistemde yetkili İK yöneticileri
        </span>
      </div>
    </div>
    
    <!-- Stat Card 3: Bugün Kayıtlar -->
    <div class="bg-white rounded-[10px] p-6 shadow-sm border border-[#ddd9d3] hover:shadow-md transition-all duration-200 cursor-pointer group">
      <div class="flex justify-between items-start mb-4">
        <div class="flex flex-col">
          <span class="font-label-md text-xs font-semibold text-[#8a8580] uppercase mb-1">Bugün Kayıtlar</span>
          <span id="stat-new-users" class="font-display-lg text-3xl text-[#1b1c1a] font-light tracking-tight group-hover:text-[#14422f] transition-colors">-</span>
        </div>
        <div class="w-10 h-10 rounded-full bg-[#f5f4f0] flex items-center justify-center text-[#8a8580]">
          <span class="material-symbols-outlined">how_to_reg</span>
        </div>
      </div>
      <div class="flex items-center gap-2 mt-2">
        <span class="text-xs text-[#8a8580] font-medium flex items-center gap-1.5">
          <span class="material-symbols-outlined text-sm text-blue-600">event_available</span>
          Bugün kaydolan yeni kullanıcılar
        </span>
      </div>
    </div>
  </div>

  <!-- Main User Management Header Bar -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white border border-[#ddd9d3] rounded-[16px] p-4 mb-6 shadow-xs">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-[#14422f]/10 text-[#14422f] flex items-center justify-center border border-[#14422f]/20 shadow-2xs">
        <span class="material-symbols-outlined text-lg">group</span>
      </div>
      <div>
        <h3 class="font-extrabold text-[#1b1c1a] text-sm tracking-tight">Kullanıcı Yönetimi</h3>
        <span id="total-text" class="text-xs text-[#8a8580] font-medium">Toplam 0 kullanıcı</span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
      <!-- Toplu Analiz Butonu -->
      <button id="bulk-reanalyze-btn" onclick="executeBulkReanalyze()" class="hidden items-center gap-2 bg-[#14422f] hover:bg-[#103425] text-white px-3.5 py-2 rounded-xl transition-all text-xs font-bold shadow-xs">
        <span class="material-symbols-outlined text-sm animate-spin hidden" id="bulk-reanalyze-spinner">sync</span>
        <span class="material-symbols-outlined text-sm" id="bulk-reanalyze-icon">analytics</span>
        <span id="bulk-reanalyze-text">Seçilenleri Yeniden Analiz Et</span>
      </button>
    </div>
  </div>

  <!-- User Table with Checkbox Column -->
  <div class="bg-white border border-[#ddd9d3] rounded-[10px] overflow-hidden shadow-sm">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-[#f5f4f0] text-[#8a8580] font-label-md text-xs uppercase tracking-wider border-b border-[#ddd9d3]">
          <th class="p-4 w-10">
            <input type="checkbox" id="select-all-users" onclick="toggleSelectAllUsers(this)" class="rounded border-[#ddd9d3] text-[#14422f] focus:ring-[#14422f]" />
          </th>
          <th class="p-4 font-semibold">Kullanıcı</th>
          <th class="p-4 font-semibold">E-posta</th>
          <th class="p-4 font-semibold">Kayıt Tarihi</th>
          <th class="p-4 font-semibold">Rol</th>
          <th class="p-4 font-semibold text-right">Aksiyon</th>
        </tr>
      </thead>
      <tbody id="users-tbody" class="font-body-sm text-sm text-[#1b1c1a] divide-y divide-[#ddd9d3]">
        <tr>
          <td colspan="6" class="p-8 text-center text-[#8a8580] font-medium">Kullanıcılar yükleniyor...</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Centered Load More / Daha Fazla Göster Button -->
  <div id="load-more-container" class="flex justify-center my-6">
    <button id="load-more-btn" onclick="toggleLoadMoreUsers()" class="px-8 py-2.5 rounded-full border border-[#1b1c1a]/30 hover:border-[#14422f] bg-white hover:bg-[#faf9f5] text-[#1b1c1a] font-bold text-xs transition-all flex items-center gap-2 shadow-xs group">
      <span id="load-more-label">Daha fazla göster</span>
      <span id="load-more-icon" class="material-symbols-outlined text-sm transition-transform duration-200 group-hover:translate-y-0.5">expand_more</span>
    </button>
  </div>

  <!-- Sayfalama Kontrolleri (Daha Fazla Göster tıklandıktan sonra gösterilir) -->
  <div id="user-pagination-container" class="hidden flex items-center justify-between bg-white border border-[#ddd9d3] rounded-[10px] p-3 shadow-sm mb-12">
    <span class="text-xs text-[#8a8580] font-medium" id="user-pagination-info">Gösterilen: 0 / Toplam 0</span>
    <div class="flex items-center gap-2" id="user-pagination-controls"></div>
  </div>

  <!-- ADIM 4: Gelişmiş Aday Filtreleme Paneli & Sonuç Tablosu -->
  <div class="mt-10 pt-6 border-t border-[#ddd9d3]">
    <div class="bg-white border border-[#ddd9d3] rounded-[16px] p-5 mb-6 shadow-xs">
      <div class="mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-[#ddd9d3] pb-3">
        <div>
          <h3 class="font-extrabold text-[#1b1c1a] text-base tracking-tight">Aday Filtreleme Paneli & Sonuç Tablosu</h3>
          <p class="text-xs text-[#8a8580] font-medium">Adayları Statü, ATS Skoru, Tarih, İsim veya E-posta adresine göre filtreleyin.</p>
        </div>
        <button onclick="clearCandidateFilters()" class="text-xs font-bold text-[#8a8580] hover:text-rose-600 transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">filter_alt_off</span>
          Filtreleri Temizle
        </button>
      </div>

      <!-- 4 Filtre Yan Yana Eşit Genişlikte Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
        <!-- 1. Min ATS Skoru -->
        <div>
          <label class="text-[10px] font-extrabold text-[#8a8580] uppercase tracking-wider block mb-1.5">MİN. ATS SKORU (%)</label>
          <select id="filter-min-ats" onchange="applyCandidateFilters(1)" class="w-full bg-[#faf9f5] border border-[#ddd9d3] hover:border-[#14422f] rounded-xl px-3 py-2 text-xs font-bold text-[#1b1c1a] focus:outline-none focus:ring-1 focus:ring-[#14422f] cursor-pointer shadow-2xs">
            <option value="">Min Skor Seçiniz...</option>
            <option value="ALL">Tümü (Hepsi)</option>
            <option value="70">%70 ve Üzeri</option>
            <option value="50">%50 ve Üzeri</option>
            <option value="30">%30 ve Üzeri</option>
          </select>
        </div>

        <!-- 2. Kayıt Sıralaması -->
        <div>
          <label class="text-[10px] font-extrabold text-[#8a8580] uppercase tracking-wider block mb-1.5">KAYIT SIRALAMASI</label>
          <select id="filter-sort-date" onchange="applyCandidateFilters(1)" class="w-full bg-[#faf9f5] border border-[#ddd9d3] hover:border-[#14422f] rounded-xl px-3 py-2 text-xs font-bold text-[#1b1c1a] focus:outline-none focus:ring-1 focus:ring-[#14422f] cursor-pointer shadow-2xs">
            <option value="desc">Yeniden Eskiye (En Yeni)</option>
            <option value="asc">Eskiden Yeniye (En Eski)</option>
          </select>
        </div>

        <!-- 3. Aday İsmi Ara -->
        <div>
          <label class="text-[10px] font-extrabold text-[#8a8580] uppercase tracking-wider block mb-1.5">ADAY İSMİ ARA</label>
          <div class="relative">
            <input type="text" id="filter-candidate-name" onkeyup="applyCandidateFilters(1)" placeholder="İsim ara..." class="w-full bg-[#faf9f5] border border-[#ddd9d3] hover:border-[#14422f] rounded-xl pl-3 pr-8 py-2 text-xs font-bold text-[#1b1c1a] focus:outline-none focus:ring-1 focus:ring-[#14422f] shadow-2xs" />
            <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[#8a8580] text-base pointer-events-none">person_search</span>
          </div>
        </div>

        <!-- 4. E-posta Ara -->
        <div>
          <label class="text-[10px] font-extrabold text-[#8a8580] uppercase tracking-wider block mb-1.5">E-POSTA ARA</label>
          <div class="relative">
            <input type="text" id="filter-candidate-email" onkeyup="applyCandidateFilters(1)" placeholder="E-posta ara..." class="w-full bg-[#faf9f5] border border-[#ddd9d3] hover:border-[#14422f] rounded-xl pl-3 pr-8 py-2 text-xs font-bold text-[#1b1c1a] focus:outline-none focus:ring-1 focus:ring-[#14422f] shadow-2xs" />
            <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[#8a8580] text-base pointer-events-none">mail_lock</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Filtrelenmiş Adaylar Sonuç Tablosu -->
    <div id="candidate-filter-table-container" class="hidden bg-white border border-[#ddd9d3] rounded-[16px] overflow-hidden shadow-xs">
      <div class="p-4 bg-[#faf9f5] border-b border-[#ddd9d3] flex justify-between items-center">
        <span class="text-xs font-bold text-[#14422f]" id="candidate-filter-count-badge">🎯 Filtreleme Sonuçları</span>
        <button onclick="clearCandidateFilters()" class="text-[11px] font-bold text-[#8a8580] hover:text-[#1b1c1a] underline">Filtreleri Temizle & Kapat</button>
      </div>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-[#f5f4f0] text-[#8a8580] font-label-md text-xs uppercase tracking-wider border-b border-[#ddd9d3]">
            <th class="p-4 w-10">
              <input type="checkbox" id="select-all-filtered-candidates" onclick="toggleSelectAllFilteredCandidates(this)" class="rounded border-[#ddd9d3] text-[#14422f] focus:ring-[#14422f]" />
            </th>
            <th class="p-4 font-semibold">Aday Bilgisi</th>
            <th class="p-4 font-semibold">E-posta</th>
            <th class="p-4 font-semibold">Kayıt Tarihi</th>
            <th class="p-4 font-semibold text-right">Aksiyonlar</th>
          </tr>
        </thead>
        <tbody id="candidate-filter-tbody" class="font-body-sm text-sm text-[#1b1c1a] divide-y divide-[#ddd9d3]">
          <tr>
            <td colspan="5" class="p-8 text-center text-[#8a8580] font-medium">Filtrelere uygun aday aranıyor...</td>
          </tr>
        </tbody>
      </table>

      <!-- 10'lu Aday Filtreleme Sayfalama Barı -->
      <div id="candidate-filter-pagination-container" class="flex items-center justify-between bg-[#faf9f5] border-t border-[#ddd9d3] p-3">
        <span class="text-xs text-[#8a8580] font-medium" id="candidate-filter-pagination-info">Gösterilen: 0 / Toplam 0</span>
        <div class="flex items-center gap-2" id="candidate-filter-pagination-controls"></div>
      </div>
    </div>
  </div>

  <script>
    import { initUsersPage } from '../../scripts/admin/users/initUsersPage';

    document.addEventListener('astro:page-load', () => {
      if (document.getElementById('users-tbody')) {
        initUsersPage();
      }
    });
  </script>
</AdminLayout>