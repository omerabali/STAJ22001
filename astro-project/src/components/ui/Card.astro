---
<!-- 
  Card.astro (İçerik Kutusu / Kartı Bileşeni)
  Görevi: İçine koyduğumuz yazıları veya grafikleri şık bir çerçeve, yumuşatılmış yuvarlak köşeler (rounded-xl) ve hafif bir gölge ile modern bir panel kartına çevirir.
-->
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["bg-surface-container border border-outline-variant/50 rounded-xl p-6 shadow-sm", className]}>
  <slot />
</div>
